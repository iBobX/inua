[Desktop Entry]
Type=Application
Name=Mail
Name[es]=Correo
Name[fr]=Courrier
Name[ja]=メール
Name[ko]=메일
Name[zh_CN]=邮件
Name[zh_TW]=郵件
Comment=Read and write mail from all your accounts
Comment[es]=Lee y escribe el correo de todas tus cuentas
Comment[fr]=Lire et écrire le courrier de tous vos comptes
Comment[ja]=すべてのアカウントのメールを読み書きする
Comment[ko]=모든 계정의 메일을 읽고 쓰기
Comment[zh_CN]=收发你所有账户的邮件
Comment[zh_TW]=收發你所有帳戶的郵件
Exec=inua-mail %u
Icon=io.github.lyricat.Inua.Mail
Categories=Network;Email;Office;
MimeType=x-scheme-handler/mailto;
Keywords=mail;email;inbox;gmail;outlook;imap;
Keywords[es]=correo;email;bandeja;gmail;outlook;imap;
Keywords[fr]=courrier;email;courriel;boîte;gmail;outlook;imap;
Keywords[ja]=メール;電子メール;受信トレイ;gmail;outlook;imap;
Keywords[ko]=메일;이메일;받은편지함;gmail;outlook;imap;
Keywords[zh_CN]=邮件;电子邮件;收件箱;gmail;outlook;imap;
Keywords[zh_TW]=郵件;電子郵件;收件匣;gmail;outlook;imap;
StartupWMClass=io.github.lyricat.Inua.Mail
StartupNotify=true
DBusActivatable=false
