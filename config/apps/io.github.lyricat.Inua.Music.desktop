[Desktop Entry]
Type=Application
Name=Music
Name[es]=Música
Name[fr]=Musique
Name[ja]=ミュージック
Name[ko]=음악
Name[zh_CN]=音乐
Name[zh_TW]=音樂
Comment=Play music, with a playlist and an equalizer
Comment[es]=Reproducir música, con una lista y un ecualizador
Comment[fr]=Écouter de la musique, avec une liste et un égaliseur
Comment[ja]=プレイリストとイコライザー付きで音楽を再生
Comment[ko]=재생 목록과 이퀄라이저로 음악 재생
Comment[zh_CN]=播放音乐，带播放列表和均衡器
Comment[zh_TW]=播放音樂，附播放清單和等化器
Exec=inua-apps music %F
Icon=io.github.lyricat.Inua.Music
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;playlist;mp3;flac;equalizer;
Keywords[es]=música;audio;reproductor;lista;mp3;flac;ecualizador;
Keywords[fr]=musique;audio;lecteur;liste;mp3;flac;égaliseur;
Keywords[ja]=音楽;オーディオ;プレーヤー;プレイリスト;mp3;flac;イコライザー;
Keywords[ko]=음악;오디오;플레이어;재생목록;mp3;flac;이퀄라이저;
Keywords[zh_CN]=音乐;音频;播放器;播放列表;mp3;flac;均衡器;
Keywords[zh_TW]=音樂;音訊;播放器;播放清單;mp3;flac;等化器;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;audio/x-matroska;audio/aiff;audio/x-aiff;audio/x-musepack;audio/x-mpegurl;audio/mpegurl;
StartupWMClass=io.github.lyricat.Inua.Music
StartupNotify=true
