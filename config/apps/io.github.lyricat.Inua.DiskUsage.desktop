[Desktop Entry]
Type=Application
Name=Disk Usage
Name[es]=Uso del disco
Name[fr]=Utilisation du disque
Name[ja]=ディスク使用量
Name[ko]=디스크 사용량
Name[zh_CN]=磁盘用量
Name[zh_TW]=磁碟用量
Comment=See what takes the room on a disk, and whether it can go
Comment[es]=Mira qué ocupa el disco y si se puede borrar
Comment[fr]=Voir ce qui occupe le disque, et si cela peut partir
Comment[ja]=ディスクを何が占めているか、削除してよいかを確かめる
Comment[ko]=디스크를 무엇이 차지하는지, 지워도 되는지 확인
Comment[zh_CN]=查看是什么占用了磁盘，以及能否删除
Comment[zh_TW]=查看是什麼佔用了磁碟，以及能否刪除
Exec=inua-disk-usage %f
Icon=io.github.lyricat.Inua.DiskUsage
Categories=System;Utility;Filesystem;
Keywords=disk;usage;space;storage;cleanup;cache;du;daisydisk;
Keywords[es]=disco;uso;espacio;almacenamiento;limpieza;caché;du;daisydisk;
Keywords[fr]=disque;utilisation;espace;stockage;nettoyage;cache;du;daisydisk;
Keywords[ja]=ディスク;使用量;容量;ストレージ;掃除;キャッシュ;du;daisydisk;
Keywords[ko]=디스크;사용량;공간;저장소;정리;캐시;du;daisydisk;
Keywords[zh_CN]=磁盘;用量;空间;存储;清理;缓存;du;daisydisk;
Keywords[zh_TW]=磁碟;用量;空間;儲存;清理;快取;du;daisydisk;
StartupWMClass=io.github.lyricat.Inua.DiskUsage
StartupNotify=true
DBusActivatable=false
