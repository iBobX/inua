[Desktop Entry]
Type=Application
Name=Terminal
Name[es]=Terminal
Name[fr]=Terminal
Name[ja]=ターミナル
Name[ko]=터미널
Name[zh_CN]=终端
Name[zh_TW]=終端
Comment=Workspaces of terminals, and the agents working in them
Comment[es]=Espacios de trabajo de terminales y los agentes que trabajan en ellos
Comment[fr]=Des espaces de travail de terminaux, et les agents qui y travaillent
Comment[ja]=ターミナルのワークスペースと、その中で働くエージェント
Comment[ko]=터미널 작업 공간과 그 안에서 일하는 에이전트
Comment[zh_CN]=终端工作区，以及在其中工作的智能体
Comment[zh_TW]=終端機工作區，以及在其中工作的代理
Exec=inua-term
Icon=io.github.lyricat.Inua.Term
Terminal=false
Categories=System;TerminalEmulator;Utility;
Keywords=shell;prompt;command;commandline;cli;agent;claude;codex;
Keywords[es]=shell;consola;orden;línea de órdenes;cli;agente;claude;codex;
Keywords[fr]=shell;invite;commande;ligne de commande;cli;agent;claude;codex;
Keywords[ja]=シェル;プロンプト;コマンド;コマンドライン;cli;エージェント;claude;codex;
Keywords[ko]=셸;프롬프트;명령;명령줄;cli;에이전트;claude;codex;
Keywords[zh_CN]=shell;提示符;命令;命令行;cli;智能体;claude;codex;
Keywords[zh_TW]=shell;提示字元;命令;命令列;cli;代理;claude;codex;
StartupWMClass=io.github.lyricat.Inua.Term
X-TerminalArgExec=-e
X-TerminalArgDir=--workspace
