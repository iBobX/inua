[Desktop Entry]
Type=Application
Name=Files
Name[es]=Archivos
Name[fr]=Fichiers
Name[ja]=ファイル
Name[ko]=파일
Name[zh_CN]=文件
Name[zh_TW]=檔案
Comment=Browse and organize files
Comment[es]=Explorar y organizar archivos
Comment[fr]=Parcourir et ranger des fichiers
Comment[ja]=ファイルを閲覧し整理する
Comment[ko]=파일 탐색 및 정리
Comment[zh_CN]=浏览和整理文件
Comment[zh_TW]=瀏覽和整理檔案
Exec=inua-files %U
Icon=io.github.lyricat.Inua.Files
Categories=System;FileTools;FileManager;Utility;Core;
Keywords=folder;manager;explore;disk;filesystem;usb;mount;
Keywords[es]=carpeta;gestor;explorar;disco;usb;montar;
Keywords[fr]=dossier;gestionnaire;explorer;disque;usb;monter;
Keywords[ja]=フォルダ;ファイルマネージャー;ディスク;USB;マウント;
Keywords[ko]=폴더;파일관리자;디스크;USB;마운트;
