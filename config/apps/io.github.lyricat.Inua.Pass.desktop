Keywords[ko]=비밀번호;pass;gpg;otp;totp;2단계 인증;비밀;
Keywords[zh_CN]=密码;pass;gpg;otp;totp;两步验证;密钥;
Keywords[zh_TW]=密碼;pass;gpg;otp;totp;兩步驗證;密鑰;
