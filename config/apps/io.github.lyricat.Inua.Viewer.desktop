[Desktop Entry]
Type=Application
Name=Viewer
Name[es]=Visor de imágenes
Name[fr]=Visionneuse d’images
Name[ja]=画像ビューアー
Name[ko]=이미지 뷰어
Name[zh_CN]=图片查看器
Name[zh_TW]=圖片檢視器
Comment=Look through pictures
Comment[es]=Mirar imágenes
Comment[fr]=Regarder à travers des images
Comment[ja]=写真に目を通す
Comment[ko]=사진을 통해 살펴보기
Comment[zh_CN]=翻看图片
Comment[zh_TW]=翻閱圖片
Exec=inua-apps viewer %F
Icon=io.github.lyricat.Inua.Viewer
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
Keywords=image;picture;photo;viewer;
Keywords[es]=imagen;foto;fotografía;visor;
Keywords[fr]=image;photo;visionneuse;
Keywords[ja]=画像;写真;ビューア;
Keywords[ko]=이미지;그림;사진;뷰어;
Keywords[zh_CN]=图像;图片;照片;看图;查看器;
Keywords[zh_TW]=圖像;圖片;照片;看圖;檢視器;
MimeType=image/avif;image/bmp;image/gif;image/heic;image/heif;image/jpeg;image/jxl;image/png;image/svg+xml;image/tiff;image/vnd.microsoft.icon;image/webp;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xpixmap;
StartupWMClass=io.github.lyricat.Inua.Viewer
StartupNotify=true
