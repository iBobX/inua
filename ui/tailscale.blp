// Tailscale: whether this device is connected, with a switch; a notice
// when something is in the way (the daemon not running, logged out, or
// not yet allowed to change it); and three tabs. Devices: the tailnet's,
// online first; one opens its addresses, connection and actions in a
// panel at the right, which takes files dropped on it (Taildrop). Exit
// Node: none or a peer. This Device: its settings, received files and
// logging out. Go fills them.
using Gtk 4.0;

ApplicationWindow tailscale {
  default-width: 460;
  default-height: 700;

  // The tabs, and the open device beside them.
  Box {
    Box {
      styles ["tailscaleapp"]
      orientation: vertical;
      width-request: 460;

      Box {
        styles ["ts-hero"]
        spacing: 16;

        Box {
          orientation: vertical;
          hexpand: true;
          valign: center;
          spacing: 4;

          Label state_title {
            styles ["ts-state"]
            xalign: 0;
            label: "—";
          }

          Label state_sub {
            styles ["sub"]
            xalign: 0;
            ellipsize: end;
          }
        }

        Switch connect {
          valign: center;
          tooltip-text:  _("Connect this device to the tailnet");
        }
      }

      // What is in the way, and the one thing that clears it.
      Box notice {
        styles ["ts-notice"]
        spacing: 12;
        visible: false;

        Label notice_text {
          hexpand: true;
          xalign: 0;
          wrap: true;
        }

        Button notice_button {
          styles ["outlined"]
          valign: center;
        }
      }

      Label note {
        styles ["ts-note"]
        visible: false;
        xalign: 0;
        wrap: true;
      }

      StackSwitcher {
        styles ["tabs"]
        stack: pages;
        halign: center;
      }

      Stack pages {
        vexpand: true;
        transition-type: crossfade;
        transition-duration: 140;

        StackPage {
          name: "devices";
          title:  _("DEVICES");

          child: Box {
            orientation: vertical;

            Box {
              styles ["composer"]

              SearchEntry filter {
                hexpand: true;
                placeholder-text:  _("Filter by name, address, OS or tag");
              }
            }

            ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Box devices {
                styles ["list", "rows"]
                orientation: vertical;
              }
            }
          };
        }

        StackPage {
          name: "exit";
          title:  _("EXIT NODE");

          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box exits {
              styles ["list"]
              orientation: vertical;
            }
          };
        }

        StackPage {
          name: "device";
          title:  _("THIS DEVICE");

          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box this_device {
              styles ["list"]
              orientation: vertical;
            }
          };
        }
      }
    }

    // The open device: a panel sliding in at the right.
    Revealer detail_reveal {
      transition-type: slide_left;
      transition-duration: 200;

      Box detail_page {
        styles ["tailscaleapp", "ts-panel"]
        orientation: vertical;
        width-request: 380;

        Box {
          styles ["bar", "detail-bar"]
          spacing: 8;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;

            Label detail_name {
              styles ["detail-name"]
              xalign: 0;
              ellipsize: end;
            }

            Label detail_sub {
              styles ["kicker"]
              xalign: 0;
              ellipsize: end;
            }
          }

          Button back {
            styles ["plain"]
            icon-name: "window-close-symbolic";
            tooltip-text:  _("Close (Escape)");
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box detail {
            styles ["list", "detail"]
            orientation: vertical;
          }
        }
      }
    }
  }
}
