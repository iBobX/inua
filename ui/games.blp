using Gtk 4.0;

ApplicationWindow games {
  default-width: 720;
  default-height: 820;

  Box {
    styles ["gamesapp"]
    orientation: vertical;

    Box {
      styles ["game-header"]
      spacing: 12;
      Button back { label: "All games"; name: "home"; }
      Label heading { styles ["game-heading"] xalign: 0; hexpand: true; }
      Button restart { label: "Restart"; name: "restart"; }
    }

    ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;
      Box {
        styles ["game-content"]
        orientation: vertical;
        spacing: 18;

        Box library { orientation: vertical; spacing: 0; }

        Box play {
          orientation: vertical;
          spacing: 16;
          Label rules { styles ["game-rules"] wrap: true; xalign: 0; max-width-chars: 65; }
          Label stats { styles ["game-stats"] wrap: true; xalign: 0; }
          Grid board {
            styles ["game-board"]
            halign: center;
            column-spacing: 5;
            row-spacing: 5;
            column-homogeneous: true;
            row-homogeneous: true;
          }
          Picture field {
            styles ["game-field"]
            can-shrink: true;
            content-fit: contain;
            width-request: 360;
            height-request: 350;
          }
          Label status { styles ["game-status"] wrap: true; xalign: 0; max-width-chars: 65; selectable: true; }
          Grid actions { column-spacing: 8; row-spacing: 8; column-homogeneous: true; }
          Label help { styles ["game-help"] wrap: true; xalign: 0; max-width-chars: 65; }
        }
      }
    }
  }
}
