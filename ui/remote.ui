                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Codec</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="stream_codec_note">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="xalign">0</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkDropDown" id="stream_codec">
                                        <property name="valign">3</property>
                                        <property name="model">
                                          <object class="GtkStringList">
                                            <items>
                                              <item>H.264</item>
                                              <item>HEVC</item>
                                              <item>AV1</item>
                                            </items>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="label"/>
                                        </style>
                                        <property name="label" translatable="yes">Play the sound on the machine too</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSwitch" id="stream_host_audio">
                                        <property name="name">stream_host_audio</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">add</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">2</property>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="page"/>
                        </style>
                        <property name="orientation">1</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="section"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-head"/>
                                </style>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="mark"/>
                                    </style>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="section-label"/>
                                    </style>
                                    <property name="label" translatable="yes">[ADD A MACHINE]</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-body"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="field"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="label"/>
                                        </style>
                                        <property name="label" translatable="yes">Its address on the network: a name, an IP address, or either with :port.</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkEntry" id="add_addr">
                                            <property name="hexpand">true</property>
                                            <property name="placeholder-text">desk.local, 192.168.1.20, desk.tail1234.ts.net</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="add_ok">
                                            <style>
                                              <class name="suggested-action"/>
                                            </style>
                                            <property name="name">add_ok</property>
                                            <property name="label" translatable="yes">Add</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="add_error">
                                        <style>
                                          <class name="sub"/>
                                          <class name="remote-error"/>
                                        </style>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>