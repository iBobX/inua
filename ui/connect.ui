                                    </style>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Pointer and keyboard</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">The device works as a touchpad and keyboard here.</property>
                                            <property name="xalign">0</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSwitch" id="set_input">
                                        <property name="name">input</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Commands</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">It runs the commands set up on This computer.</property>
                                            <property name="xalign">0</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSwitch" id="set_commands">
                                        <property name="name">commands</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">add</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">2</property>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="page"/>
                        </style>
                        <property name="orientation">1</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="section"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-head"/>
                                </style>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="mark"/>
                                    </style>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="section-label"/>
                                    </style>
                                    <property name="label" translatable="yes">[ADD A DEVICE]</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-body"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="field"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="label"/>
                                        </style>
                                        <property name="label" translatable="yes">A device the network's broadcast does not reach: its name or IP address. It is asked to connect here; it shows in the list once it has.</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkEntry" id="add_addr">
                                            <property name="hexpand">true</property>
                                            <property name="placeholder-text">192.168.1.20, phone.tail1234.ts.net</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="add_ok">
                                            <style>
                                              <class name="suggested-action"/>
                                            </style>
                                            <property name="name">add_ok</property>
                                            <property name="label" translatable="yes">Add</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="add_error">
                                        <style>
                                          <class name="sub"/>
                                          <class name="connect-error"/>
                                        </style>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>