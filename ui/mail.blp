// Mail (docs/feat/inua-mail.md): the mailboxes of every account on the
// left, the conversations of the one chosen in the middle, the
// conversation on the right. The index's rows, the list's rows and the
// conversation are made in Go.
//
//   start  — no account yet: what Mail does, and the three ways to add one
//   empty  — nothing chosen
//   read   — the conversation chosen
using Gtk 4.0;

ApplicationWindow mail {
  styles ["settings", "mail"]
  title: _("Mail");
  default-width: 1320;
  default-height: 840;

  Box {
    // ── the index ──────────────────────────────────────────────────────
    Box {
      styles ["index", "mail-index"]
      orientation: vertical;
      width-request: 236;
      hexpand: false;

      Box {
        styles ["mail-index-head"]

        Label {
          styles ["index-title"]
          label: _("Mail");
          xalign: 0;
          hexpand: true;
        }

        Button compose {
          styles ["outlined", "mail-compose-button"]
          label: _("Compose");
          tooltip-text: _("Write a message (C)");
          valign: center;
        }
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-width: false;
        vexpand: true;

        // All inboxes, Needs reply, Starred, then each account's mailboxes.
        Box side {
          styles ["mail-side"]
          orientation: vertical;
          spacing: 1;
        }
      }

      Button add_account {
        styles ["index-item", "mail-add"]

        Label {
          styles ["title"]
          label: _("Add account");
          xalign: 0;
        }
      }
    }

    // ── the conversations ──────────────────────────────────────────────
    Box {
      styles ["mail-list"]
      orientation: vertical;
      width-request: 380;
      hexpand: false;

      SearchEntry search {
        styles ["mail-search"]
        placeholder-text: _("Search, or ask in a sentence");
      }

      Label search_note {
        styles ["sub", "mail-search-note"]
        xalign: 0;
        wrap: true;
        visible: false;
      }

      // All, Unread, With files, Needs reply; Go fills it.
      Box filters {
        styles ["mail-filters"]
        spacing: 16;
      }

      Stack list_stack {
        vexpand: true;

        StackPage {
          name: "list";

          child: ScrolledWindow list_scroll {
            hscrollbar-policy: never;
          };
        }

        StackPage {
          name: "empty";

          child: Label list_empty {
            styles ["sub", "mail-list-empty"]
            valign: center;
            wrap: true;
            justify: center;
          };
        }
      }

      Label list_error {
        styles ["sub", "error", "mail-list-error"]
        xalign: 0;
        wrap: true;
        visible: false;
      }

      Button older {
        styles ["mail-older"]
        label: _("Load older");
        visible: false;
      }
    }

    // ── the conversation ───────────────────────────────────────────────
    Stack reader_stack {
      hexpand: true;

      StackPage {
        name: "empty";

        child: Label reader_empty {
          styles ["sub", "mail-reader-empty"]
          label: _("No conversation chosen");
          valign: center;
        };
      }

      StackPage {
        name: "read";

        child: ScrolledWindow reader_scroll {
          hscrollbar-policy: never;

          Box reader {
            styles ["mail-reader"]
            orientation: vertical;
            spacing: 16;
            halign: start;
          }
        };
      }

      StackPage {
        name: "start";

        child: Box {
          styles ["mail-start"]
          orientation: vertical;
          spacing: 14;
          valign: center;
          halign: center;

          Label {
            styles ["mail-start-title"]
            label: _("Your mail, in three columns");
            xalign: 0;
          }

          Label {
            styles ["label", "mail-start-text"]
            label: _("Add an account to begin. Gmail and Outlook sign in on their own page in your browser; any other account signs in with its IMAP server and a password. Mail keeps a copy of what it reads, so it opens with your inbox even before it connects.");
            xalign: 0;
            wrap: true;
            max-width-chars: 58;
          }

          Box {
            spacing: 8;
            margin-top: 6;

            Button start_google {
              styles ["outlined"]
              label: _("Google");
            }

            Button start_microsoft {
              styles ["outlined"]
              label: _("Microsoft");
            }

            Button start_other {
              styles ["outlined"]
              label: _("Other (IMAP)");
            }
          }
        };
      }
    }
  }
}
