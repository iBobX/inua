// Mail (docs/feat/inua-mail.md): the mailboxes of every account on the
// left, the conversations of the one chosen in the middle, the
// conversation on the right; or, with no account yet and when one is
// added, the welcome: the address, the sign-in, the first sync. The
// index's rows, the list's rows, the conversation and the welcome's steps
// are made in Go.
//
//   main    — the three columns
//   welcome — adding an account
using Gtk 4.0;

ApplicationWindow mail {
  styles ["settings", "mail"]
  title: _("Mail");
  default-width: 1320;
  default-height: 840;

  Stack top {
    transition-type: crossfade;
    transition-duration: 120;

    StackPage {
      name: "main";

      child: Box {
        // ── the index ──────────────────────────────────────────────────
        Box {
          styles ["index", "mail-index"]
          orientation: vertical;
          width-request: 236;
          hexpand: false;

          // A readout of the sync: its state and time, the messages and the
          // unread; Go fills it.
          Box {
            styles ["mail-index-head"]

            Box {
              orientation: vertical;
              hexpand: true;
              valign: center;
              spacing: 4;

              Box {
                spacing: 7;

                Box status_mark {
                  styles ["mark", "mail-status-mark"]
                  valign: center;
                }

                Label status_state {
                  styles ["mail-status"]
                  xalign: 0;
                }
              }

              Label status_counts {
                styles ["mail-status-counts"]
                xalign: 0;
              }
            }

            Button compose {
              styles ["outlined", "mail-compose-button"]
              icon-name: "document-edit-symbolic";
              tooltip-text: _("Write a message (C)");
              valign: center;
            }
          }

          ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-width: false;
            vexpand: true;

            // All inboxes, Needs reply, Starred, then each account's mailboxes.
            Box side {
              styles ["mail-side"]
              orientation: vertical;
              spacing: 1;
            }
          }

          Button add_account {
            styles ["index-item", "mail-add"]

            Label {
              styles ["title"]
              label: _("Add account");
              xalign: 0;
            }
          }
        }

        // ── the conversations ──────────────────────────────────────────
        Box {
          styles ["mail-list"]
          orientation: vertical;
          width-request: 380;
          hexpand: false;

          SearchEntry search {
            styles ["mail-search"]
            placeholder-text: _("Search, or ask in a sentence");
          }

          Label search_note {
            styles ["sub", "mail-search-note"]
            xalign: 0;
            wrap: true;
            visible: false;
          }

          // All, Unread, With files, Needs reply; Go fills it.
          Box filters {
            styles ["mail-filters"]
            spacing: 16;
          }

          Stack list_stack {
            vexpand: true;

            StackPage {
              name: "list";

              child: ScrolledWindow list_scroll {
                hscrollbar-policy: never;
              };
            }

            StackPage {
              name: "empty";

              child: Label list_empty {
                styles ["sub", "mail-list-empty"]
                valign: center;
                wrap: true;
                justify: center;
              };
            }
          }

          Label list_error {
            styles ["sub", "error", "mail-list-error"]
            xalign: 0;
            wrap: true;
            visible: false;
          }

          // Older mail loads as the list nears its end; this says so.
          Label older {
            styles ["mail-older"]
            label: _("Loading older mail…");
            xalign: 0;
            visible: false;
          }

          // What was just archived, deleted or moved, a few seconds to
          // take it back; the server is told when it goes.
          Box undo_bar {
            styles ["mail-undo"]
            spacing: 12;
            visible: false;

            Label undo_text {
              styles ["mail-undo-text"]
              xalign: 0;
              hexpand: true;
              ellipsize: end;
            }

            Button undo {
              styles ["mail-link"]
              label: _("Undo");
            }

            Label {
              styles ["mail-keys"]
              label: "Z";
            }
          }
        }

        // ── the conversation ───────────────────────────────────────────
        Stack reader_stack {
          hexpand: true;

          StackPage {
            name: "empty";

            child: Label reader_empty {
              styles ["sub", "mail-reader-empty"]
              label: _("No conversation chosen");
              valign: center;
            };
          }

          StackPage {
            name: "read";

            child: ScrolledWindow reader_scroll {
              hscrollbar-policy: never;

              Box reader {
                styles ["mail-reader"]
                orientation: vertical;
                spacing: 16;
                halign: start;
              }
            };
          }
        }
      };
    }

    // ── the welcome ────────────────────────────────────────────────────
    StackPage {
      name: "welcome";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        Box welcome {
          styles ["mail-welcome"]
          orientation: vertical;
          halign: center;
          valign: center;
        }
      };
    }
  }
}
