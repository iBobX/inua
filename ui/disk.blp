// Disk Usage: what takes the room on a disk. The index on the left lists
// the places to scan (the home, each disk, a folder chosen) and what the
// scans found (the developer's, the agents' and AI's, the caches); the page
// beside it is the one chosen; the panel on the right is the item chosen:
// what it is, whether it can go, and deleting it.
//
//   place — a place: Scan, then the trail of the folders above the one in
//           view, its map, and under the map the list of what is in it
//   kind  — the folders of a kind every scan found, largest first
using Gtk 4.0;

ApplicationWindow disk {
  styles ["settings", "disk"]
  title: _("Disk Usage");
  default-width: 1180;
  default-height: 760;

  Box {
    // ── the index ──────────────────────────────────────────────────────
    Box {
      styles ["index"]
      orientation: vertical;
      width-request: 220;
      hexpand: false;

      Label {
        styles ["index-title"]
        label: _("Disk Usage");
        xalign: 0;
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-width: false;
        vexpand: true;

        Box {
          styles ["disk-index"]
          orientation: vertical;
          spacing: 2;

          Label {
            styles ["kicker", "disk-kicker"]
            label: _("PLACES");
            xalign: 0;
          }

          // The home, the disks, folders chosen; Go fills it.
          Box side_places {
            orientation: vertical;
            spacing: 2;
          }

          Button side_choose {
            styles ["index-item"]
            name: "side_choose";

            Box {
              spacing: 10;

              Image {
                styles ["index-icon"]
                icon-name: "folder-open-symbolic";
              }

              Label {
                styles ["title"]
                label: _("Choose a folder…");
                xalign: 0;
              }
            }
          }

          Label {
            styles ["kicker", "disk-kicker"]
            label: _("FOUND");
            xalign: 0;
          }

          // Developer, Agents and AI, Caches; Go fills it.
          Box side_kinds {
            orientation: vertical;
            spacing: 2;
          }
        }
      }
    }

    // ── the pages ──────────────────────────────────────────────────────
    Stack pages {
      hexpand: true;
      hhomogeneous: false;
      transition-type: crossfade;
      transition-duration: 120;

      StackPage {
        name: "place";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          Box {
            styles ["page"]
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label place_label {
                  styles ["section-label"]
                  xalign: 0;
                }

                Label place_meta {
                  styles ["readout", "disk-meta"]
                  hexpand: true;
                  xalign: 1;
                  ellipsize: end;
                }

                Button place_stop {
                  styles ["outlined"]
                  name: "place_stop";
                  label: _("Stop");
                  valign: center;
                  visible: false;
                }

                Button place_scan {
                  styles ["suggested-action"]
                  name: "place_scan";
                  label: _("Scan");
                  valign: center;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                // Why the scan failed.
                Label place_error {
                  styles ["row", "sub", "disk-error"]
                  xalign: 0;
                  wrap: true;
                  selectable: true;
                  visible: false;
                }

                // The trail, the map and the list: before a scan, the
                // disk's used and free room; while scanning, the folders
                // measured so far; after it, the folder in view.
                Box place_map {
                  orientation: vertical;
                  spacing: 12;

                  // The folders from the place to the one in view.
                  Box crumbs {
                    styles ["disk-crumbs"]
                    spacing: 2;
                  }

                  Box {
                    orientation: vertical;
                    spacing: 18;

                    // The map is drawn in Go (internal/diskui/map.go).
                    Overlay map_overlay {
                      halign: center;

                      [overlay]
                      Box map_middle {
                        orientation: vertical;
                        halign: center;
                        valign: center;
                        can-target: false;
                        width-request: 120;

                        Label map_name {
                          styles ["disk-middle-name"]
                          justify: center;
                          ellipsize: middle;
                          max-width-chars: 10;
                        }

                        Label map_size {
                          styles ["readout"]
                          justify: center;
                        }
                      }

                    }

                    // Before a scan: one line.
                    Label place_empty {
                      styles ["disk-hint", "disk-quiet"]
                      justify: center;
                      wrap: true;
                      max-width-chars: 48;
                    }

                    // While scanning: how far it has come, and where.
                    Box place_progress {
                      styles ["disk-hint"]
                      orientation: vertical;
                      spacing: 4;
                      visible: false;

                      Label progress_text {
                        styles ["readout"]
                      }

                      Label progress_at {
                        styles ["sub", "disk-path"]
                        ellipsize: middle;
                        max-width-chars: 60;
                      }
                    }

                    // What is in the folder in view, largest first.
                    Box map_list {
                      styles ["rows", "disk-list"]
                      orientation: vertical;
                    }
                  }

                  // What the map's colours are.
                  Box legend {
                    styles ["disk-legend"]
                    spacing: 18;
                  }
                }
              }
            }
          }
        };
      }

      StackPage {
        name: "kind";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          Box {
            styles ["page"]
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label kind_label {
                  styles ["section-label"]
                  xalign: 0;
                }

                Label kind_meta {
                  styles ["readout", "disk-meta"]
                  hexpand: true;
                  xalign: 1;
                  ellipsize: end;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Label kind_desc {
                  styles ["row", "sub"]
                  xalign: 0;
                  wrap: true;
                }

                // Nothing to list: the kind's mark and why, in one line.
                Box kind_empty {
                  styles ["disk-empty"]
                  orientation: vertical;
                  spacing: 12;
                  halign: center;
                  visible: false;

                  Image kind_empty_icon {
                    pixel-size: 40;
                  }

                  Label kind_empty_text {
                    styles ["disk-quiet"]
                    justify: center;
                    wrap: true;
                    max-width-chars: 40;
                  }
                }

                // The folders of the kind, largest first; Go fills it.
                Box kind_rows {
                  styles ["rows"]
                  orientation: vertical;
                }
              }
            }
          }
        };
      }
    }

    // ── the item chosen ────────────────────────────────────────────────
    Box {
      styles ["disk-details"]
      orientation: vertical;
      width-request: 310;
      hexpand: false;

      ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-width: false;
        vexpand: true;

        Box {
          styles ["disk-details-body"]
          orientation: vertical;

          // Nothing chosen: a mark, no words.
          Image details_empty {
            styles ["disk-empty"]
            icon-name: "disk-choose-symbolic";
            pixel-size: 48;
            vexpand: true;
            valign: center;
            halign: center;
          }

          Box details {
            orientation: vertical;
            visible: false;

            // The item: its kind's tag, its name and where it is, with the
            // ways to look at it on the right; then its size, files and when
            // it changed, side by side.
            Box {
              styles ["disk-item"]
              orientation: vertical;
              spacing: 2;

              Box {
                spacing: 8;

                Box {
                  orientation: vertical;
                  spacing: 2;
                  hexpand: true;

                  Label sel_tag {
                    styles ["tag"]
                    xalign: 0;
                    halign: start;
                    visible: false;
                  }

                  Label sel_name {
                    styles ["disk-name"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                  }

                  Label sel_path {
                    styles ["sub", "disk-path"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: char;
                    selectable: true;
                  }
                }

                Box {
                  spacing: 4;
                  valign: start;

                  Button sel_map {
                    styles ["outlined", "image-button"]
                    name: "sel_map";
                    icon-name: "disk-locate-symbolic";
                    tooltip-text: _("Show on the map");
                  }

                  Button sel_open {
                    styles ["outlined", "image-button"]
                    name: "sel_open";
                    icon-name: "folder-open-symbolic";
                    tooltip-text: _("Show in Files");
                  }
                }
              }

              // Go fills it: a figure and its name, each.
              Box sel_facts {
                styles ["disk-facts"]
                homogeneous: true;
              }

              // Some of it could not be read.
              Label sel_meta {
                styles ["sub", "warn-text"]
                xalign: 0;
                wrap: true;
                visible: false;
              }

              // What was just done here: deleted, cleaned, and the room
              // it freed.
              Label sel_done {
                styles ["sub", "disk-done"]
                xalign: 0;
                wrap: true;
                visible: false;
              }

              Label sel_item_error {
                styles ["sub", "disk-error"]
                xalign: 0;
                wrap: true;
                selectable: true;
                visible: false;
              }
            }

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label: _("[CAN IT GO]");
                  hexpand: true;
                  xalign: 0;
                }

                // The verdict, the checks' or the AI's.
                Label sel_verdict {
                  styles ["disk-verdict-tag"]
                  valign: center;
                  visible: false;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;
                spacing: 14;

                // The route: each check, the one that settled it, and its
                // end: the verdict, or asking the AI. Go fills it.
                Box sel_steps {
                  styles ["disk-route"]
                  orientation: vertical;
                }

                Box sel_clean_box {
                  orientation: vertical;
                  spacing: 6;
                  visible: false;

                  Label {
                    styles ["sub", "disk-command-head"]
                    label: _("Clean it with:");
                    xalign: 0;
                  }

                  Label sel_clean {
                    styles ["readout", "disk-command"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: char;
                    selectable: true;
                  }

                  Box {
                    spacing: 6;

                    Button sel_copy {
                      styles ["outlined"]
                      name: "sel_copy";
                      label: _("Copy");
                    }

                    Button sel_run {
                      styles ["outlined"]
                      name: "sel_run";
                      label: _("Run");
                    }
                  }

                  // Why inua cannot run it, or how it runs.
                  Label sel_run_note {
                    styles ["sub"]
                    xalign: 0;
                    wrap: true;
                  }

                  // What the command printed, its end.
                  Label sel_run_out {
                    styles ["readout", "disk-output"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: char;
                    selectable: true;
                    visible: false;
                  }

                  Label sel_run_done {
                    styles ["sub", "disk-done"]
                    xalign: 0;
                    wrap: true;
                    visible: false;
                  }

                  Label sel_run_error {
                    styles ["sub", "disk-error"]
                    xalign: 0;
                    wrap: true;
                    selectable: true;
                    visible: false;
                  }
                }

                Box {
                  orientation: vertical;
                  spacing: 6;

                  Box {
                    spacing: 6;

                    Button sel_trash {
                      styles ["outlined"]
                      name: "sel_trash";
                      label: _("Move to Trash");
                    }

                    Button sel_delete {
                      styles ["outlined", "danger"]
                      name: "sel_delete";
                      label: _("Delete…");
                    }
                  }

                  Label sel_delete_note {
                    styles ["sub"]
                    xalign: 0;
                    wrap: true;
                  }

                  Label sel_delete_error {
                    styles ["sub", "disk-error"]
                    xalign: 0;
                    wrap: true;
                    selectable: true;
                    visible: false;
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
