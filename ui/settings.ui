                                                  <class name="sub"/>
                                                </style>
                                                <property name="label" translatable="yes">A notification says when a new release is out, with a button to upgrade</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="about_daily">
                                            <property name="name">about_daily</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;CHANGELOG&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">What the latest release changed</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="about_changelog">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_about">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>