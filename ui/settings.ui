                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkScale" id="tp_speed">
                                            <property name="name">tp_speed</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <property name="draw-value">false</property>
                                            <property name="adjustment">
                                              <object class="GtkAdjustment">
                                                <property name="lower">-1</property>
                                                <property name="upper">1</property>
                                                <property name="step-increment">0.05</property>
                                                <property name="page-increment">0.25</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator"></object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label">Acceleration</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="label">Faster swipes move the pointer further</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="tp_accel">
                                            <property name="name">tp_accel</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label">&lt;span alpha='55%'&gt;[&lt;/span&gt;SOURCE&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label">inua writes these to Hyprland's inua.conf</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkLabel" id="tp_state">
                                            <style>
                                              <class name="title"/>
                                            </style>
                                            <property name="hexpand">true</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="tp_reset">
                                            <style>
                                              <class name="outlined"/>
                                            </style>
                                            <property name="name">tp_reset</property>
                                            <property name="valign">3</property>
                                            <property name="label">Use hyprland.conf</property>
                                            <property name="tooltip-text">Stop setting the touchpad in inua</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_mouse">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>