// Virtual machines: manages machines, one folder each. The window shows them
// as tiles in its library and the chosen machine's page in a panel at the
// right; Go switches between the pages as the machine's state changes. With
// no machine yet the library says so and the panel is hidden. New machine
// asks in a dialog of its own (vm_new_dialog, at the end).
//
//   fault        — a folder that does not load as a machine
//   unavailable  — this build has no backend for the machine's kind
//   console      — only a serial console: its debugger and its output
//   prereq       — some host requirement is missing; shows what and why
//   setup        — environment is ready; nothing installed yet
//   provisioning — first-time install (download / setup)
//   starting     — the guest is installed and coming up
//   stopped      — the guest is installed and off
//   running      — the guest is up; see it or stop it
//
// None of the pages show controls that belong to a different stage. The head
// says the machine's state; an error shows under the section whose action
// failed (Go fills the `vm_*_error` labels), never in the head.
using Gtk 4.0;

ApplicationWindow vm {
  styles ["settings", "vmpage"]
  title: _("Virtual machines");
  default-width: 1120;
  default-height: 720;

  Box {
    // ── the library: the machines, one a tile ──
    Box {
      styles ["library"]
      orientation: vertical;
      hexpand: true;

      Box {
        styles ["library-head"]
        spacing: 12;

        Box {
          orientation: vertical;
          hexpand: true;
          valign: center;
          spacing: 2;

          Label {
            styles ["library-title"]
            label: _("Virtual machines");
            xalign: 0;
          }

          Label {
            styles ["sub"]
            label: _("Machines keep running with this window closed.");
            xalign: 0;
            wrap: true;
          }
        }

        Button vm_new {
          styles ["outlined", "library-new"]
          name: "new_machine";
          valign: center;

          Box {
            spacing: 8;

            Image {
              icon-name: "list-add-symbolic";
            }

            Label {
              label: _("New machine…");
            }
          }
        }
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;

          Label vm_machines_kicker {
            styles ["kicker", "library-kicker"]
            label: _("MACHINES");
            xalign: 0;
          }

          // Go appends a tile per machine: its system's mark, its mark filled
          // while it is up, its name, and what it is and is doing.
          FlowBox vm_machines {
            styles ["library-tiles"]
            selection-mode: single;
            activate-on-single-click: true;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 8;
            column-spacing: 12;
            row-spacing: 12;
            valign: start;
          }

          // Folders under the store that do not load as a machine.
          Label vm_fault_heading {
            styles ["kicker", "library-kicker"]
            label: _("NEEDS RECOVERY");
            xalign: 0;
            visible: false;
          }

          FlowBox vm_faults {
            styles ["library-tiles"]
            selection-mode: single;
            activate-on-single-click: true;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 8;
            column-spacing: 12;
            row-spacing: 12;
            valign: start;
            visible: false;
          }

          // Nothing made yet; the panel is hidden until New opens it.
          Box vm_library_empty {
            orientation: vertical;
            vexpand: true;
            valign: center;
            halign: center;
            spacing: 8;
            margin-start: 32;
            margin-end: 32;
            visible: false;

            Image {
              styles ["library-empty-mark"]
              icon-name: "vm-machine-symbolic";
              pixel-size: 48;
            }

            Label {
              styles ["library-empty-title"]
              label: _("No machines yet");
            }

            Label {
              styles ["sub"]
              label: _("A machine runs Windows, Linux, FreeBSD, Android or a system of your own, in a window on this desktop.");
              justify: center;
              wrap: true;
              max-width-chars: 48;
            }

            Button vm_empty_new {
              styles ["suggested-action"]
              name: "new_machine";
              label: _("New machine…");
              halign: center;
              margin-top: 8;
            }
          }
        }
      }
    }

    // ── the panel: the chosen machine's page ──
    Box vm_panel {
      styles ["library-panel"]
      orientation: vertical;
      width-request: 520;
      hexpand: false;

      Box vm_head {
        styles ["panel-head"]
        spacing: 12;

        // Filled while the machine is up, hollow when it is not.
        Box vm_mark {
          styles ["mark"]
          valign: center;
        }

        Box {
          orientation: vertical;
          hexpand: true;
          valign: center;
          spacing: 2;

          Label vm_title {
            styles ["panel-title"]
            xalign: 0;
            ellipsize: end;
          }

          Label vm_sub {
            styles ["sub"]
            xalign: 0;
            ellipsize: end;
          }
        }
      }

      // No transition: a crossfade into a page whose progress bar was moving
      // never finished, and the window stayed on the page before.
      Stack vm_stack {
        vexpand: true;

        // ── PAGE: fault ── a folder that does not load as a machine
        StackPage {
          name: "fault";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[FOLDER]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Folder");
                        xalign: 0;
                      }

                      Label vm_fault_path {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }
                  }

                  Label vm_fault_error {
                    styles ["sub", "vm-error"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                    selectable: true;
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Delete the folder");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("This folder cannot be loaded as a machine. Deleting it removes everything inside, for good.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_fault_delete {
                      styles ["outlined", "danger"]
                      name: "fault_delete";
                      label: _("Delete…");
                      valign: center;
                    }
                  }
                }

                Label vm_fault_action_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: unavailable ── this build cannot run the machine
        StackPage {
          name: "unavailable";
          child: Box {
            orientation: vertical;
            valign: center;
            halign: center;
            spacing: 8;
            margin-start: 32;
            margin-end: 32;

            Image {
              styles ["vm-empty-mark"]
              icon-name: "dialog-warning-symbolic";
              pixel-size: 48;
            }

            Label {
              styles ["vm-empty-title"]
              label: _("No backend for this machine");
            }

            Label vm_na_note {
              styles ["sub"]
              justify: center;
              wrap: true;
            }
          };
        }

        // ── PAGE: console ── a machine's serial console and its debugger
        StackPage {
          name: "console";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[CONSOLE]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Button vm_console_back {
                    styles ["outlined"]
                    name: "console_back";
                    label: _("Back");
                    valign: center;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label vm_console_summary {
                        styles ["label"]
                        xalign: 0;
                        wrap: true;
                      }

                      Label vm_console_hardware {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Wait for a debugger");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Holds the guest at its first instruction, for gdb on 127.0.0.1:1234.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch vm_console_gdb {
                      name: "console_gdb";
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Debugger");
                        xalign: 0;
                      }

                      Label vm_console_cmd {
                        styles ["sub", "vm-command"]
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;
                        selectable: true;
                      }
                    }

                    Button vm_console_copy {
                      styles ["outlined"]
                      name: "console_copy";
                      label: _("Copy");
                      valign: center;
                    }
                  }
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[SERIAL]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Button vm_console_start {
                    styles ["outlined"]
                    name: "console_start";
                    label: _("Start");
                    valign: center;
                  }

                  Button vm_console_stop {
                    styles ["outlined"]
                    name: "console_stop";
                    label: _("Stop");
                    valign: center;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // The output grows with the window; Go keeps it at its end.
                  ScrolledWindow {
                    vexpand: true;
                    height-request: 320;
                    hscrollbar-policy: never;

                    TextView vm_serial {
                      styles ["vm-console"]
                      editable: false;
                      cursor-visible: false;
                      wrap-mode: word_char;
                      top-margin: 10;
                      bottom-margin: 10;
                      left-margin: 12;
                      right-margin: 12;
                    }
                  }
                }

                Label vm_console_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: prereq ── the host is missing something the machine needs
        StackPage {
          name: "prereq";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[HOST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_check_count {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // Go appends one row per check that failed.
                  Box vm_check_rows {
                    styles ["rows", "vm-check-rows"]
                    orientation: vertical;
                  }

                  // What the last fix did.
                  Label vm_fix_note {
                    styles ["row", "sub", "vm-note"]
                    xalign: 0;
                    wrap: true;
                    selectable: true;
                    visible: false;
                  }
                }
              }

              // Asking for help is the assistant's job, not the window's: inua itself runs no package manager and no privileged install.
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[ASSISTANT]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Ask the assistant to fix this");
                        xalign: 0;
                      }

                      Label vm_assistant_note {
                        styles ["sub"]
                        label: _("It checks what is missing, says what it would change, and runs it with its own approval.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_assistant_ask {
                      styles ["outlined"]
                      name: "assistant_ask";
                      label: _("Ask the assistant");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Check again");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Reads the host again, after something has changed.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_assistant_recheck {
                      styles ["outlined"]
                      name: "assistant_recheck";
                      label: _("Check again");
                      valign: center;
                    }
                  }
                }

                Label vm_assistant_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: setup ── nothing installed yet
        StackPage {
          name: "setup";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              // what the guest gets
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Button vm_accept {
                    styles ["outlined"]
                    name: "accept";
                    label: _("Use recommended");
                    valign: center;
                    visible: false;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Memory (GiB)");
                        xalign: 0;
                      }

                      Label vm_memory_sub {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    SpinButton vm_memory {
                      adjustment: Adjustment {
                        lower: 2;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 4;
                        value: 8;
                      };
                      numeric: true;
                      width-chars: 4;
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("CPU cores");
                        xalign: 0;
                      }

                      Label vm_cpus_sub {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    SpinButton vm_cpus {
                      adjustment: Adjustment {
                        lower: 1;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 2;
                        value: 4;
                      };
                      numeric: true;
                      width-chars: 4;
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Disk size (GiB)");
                        xalign: 0;
                      }

                      Label vm_disk_sub {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    SpinButton vm_disk {
                      adjustment: Adjustment {
                        lower: 8;
                        upper: 2048;
                        step-increment: 8;
                        page-increment: 64;
                        value: 64;
                      };
                      numeric: true;
                      width-chars: 4;
                      valign: center;
                    }
                  }
                }
              }

              // The sentence under it is Go's: a system installed from its own media and one a container installs differ.
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[INSTALL]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Install the system");
                        xalign: 0;
                      }

                      Label vm_setup_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_install {
                      styles ["suggested-action"]
                      name: "install";
                      label: _("Install");
                      valign: center;
                    }
                  }
                }

                Label vm_setup_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }

              // The media a QEMU machine installs from: osinfo-db's catalog, a row per system.
              Box vm_setup_media {
                styles ["section"]
                orientation: vertical;
                visible: false;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[IMAGE]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_media_source {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Label vm_media_note {
                    styles ["sub", "vm-media-note"]
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                  }

                  // The download in flight, above the list, so starting one does not
                  // put its progress two hundred rows away.
                  Box vm_media_progress {
                    styles ["row"]
                    spacing: 16;
                    visible: false;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 8;

                      ProgressBar vm_iso_progress {
                        show-text: false;
                        hexpand: true;
                      }

                      Label vm_iso_progress_text {
                        styles ["sub", "readout"]
                        xalign: 0;
                      }
                    }

                    Button vm_iso_cancel {
                      styles ["outlined"]
                      name: "iso_cancel";
                      label: _("Stop");
                      valign: center;
                    }
                  }

                  Box vm_media_filters {
                    styles ["vm-media-filters"]
                    orientation: vertical;
                    spacing: 8;

                    Entry vm_iso_search {
                      hexpand: true;
                      placeholder-text: _("Search systems and images");
                    }

                    Box {
                      spacing: 8;

                      DropDown vm_iso_platform {
                        styles ["vm-iso-filter"]
                        valign: center;
                        tooltip-text: _("Which platform to show");
                      }

                      DropDown vm_iso_arch {
                        styles ["vm-iso-filter"]
                        valign: center;
                        tooltip-text: _("Which architecture to show");
                      }

                      Box {
                        hexpand: true;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Prerelease");
                        valign: center;
                      }

                      Switch vm_iso_prerelease {
                        valign: center;
                        tooltip-text: _("Also show prerelease and development systems");
                      }

                      Label {
                        styles ["sub", "vm-switch-label"]
                        label: _("Ended");
                        valign: center;
                      }

                      Switch vm_iso_eol {
                        valign: center;
                        tooltip-text: _("Also show systems past their support date");
                      }
                    }
                  }

                  Label vm_media_count {
                    styles ["sub", "vm-media-count"]
                    xalign: 0;
                  }

                  Label {
                    styles ["kicker", "vm-media-group"]
                    label: _("RECOMMENDED");
                    xalign: 0;
                  }

                  Box vm_media_recommended {
                    styles ["vm-media-rows"]
                    orientation: vertical;
                  }

                  Label {
                    styles ["kicker", "vm-media-group"]
                    label: _("ALL SYSTEMS");
                    xalign: 0;
                  }

                  Box vm_media_rows {
                    styles ["vm-media-rows"]
                    orientation: vertical;
                  }
                }

                Label vm_media_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[REMOVE]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box vm_setup_leftovers_row {
                    styles ["row"]
                    spacing: 16;
                    visible: false;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Files from an earlier attempt");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Installing reuses them. Delete them to start over.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_setup_remove_data {
                      styles ["outlined", "danger"]
                      name: "setup_remove_data";
                      label: _("Delete…");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Delete the machine");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("The machine and all its files, for good.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_setup_delete {
                      styles ["outlined", "danger"]
                      name: "setup_delete";
                      label: _("Delete…");
                      valign: center;
                    }
                  }
                }

                Label vm_setup_remove_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: provisioning ── the first installation, running or paused
        StackPage {
          name: "provisioning";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[INSTALL]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_progress_meta {
                    styles ["section-meta", "readout"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    orientation: vertical;
                    spacing: 10;

                    ProgressBar vm_progress {
                      show-text: false;
                    }

                    Label vm_progress_text {
                      styles ["sub"]
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                    }
                  }

                  // While it runs: watch it, or pause it.
                  Box vm_prov_watch_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label vm_prov_watch_title {
                        styles ["label"]
                        label: _("Watch the installation");
                        xalign: 0;
                        wrap: true;
                      }

                      Label vm_prov_watch_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_console {
                      styles ["outlined"]
                      name: "console";
                      label: _("Open");
                      valign: center;
                    }
                  }

                  Box vm_prov_stop_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Pause the installation");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Stops the guest; the disk is kept, and Continue picks up from there.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_prov_stop {
                      styles ["outlined"]
                      name: "prov_stop";
                      label: _("Stop");
                      valign: center;
                    }
                  }

                  // While it is paused: go on, start over, or give up.
                  Box vm_prov_start_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Continue the installation");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Starts the guest again; the installation goes on from where it was.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_prov_start {
                      styles ["suggested-action"]
                      name: "prov_start";
                      label: _("Continue");
                      valign: center;
                    }
                  }

                  Box vm_prov_remove_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label vm_prov_remove_title {
                        styles ["label"]
                        xalign: 0;
                        wrap: true;
                      }

                      Label vm_prov_remove_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_prov_remove {
                      styles ["outlined"]
                      name: "prov_remove";
                      label: _("Start over…");
                      valign: center;
                    }
                  }

                  Box vm_prov_delete_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Delete the machine");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("The machine and all its files, for good.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_prov_delete {
                      styles ["outlined", "danger"]
                      name: "prov_delete";
                      label: _("Delete…");
                      valign: center;
                    }
                  }
                }

                Label vm_prov_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: starting ── installed, and coming up
        StackPage {
          name: "starting";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_boot_summary {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    orientation: vertical;
                    spacing: 10;

                    ProgressBar vm_boot_progress {
                      show-text: false;
                    }

                    Label vm_boot_progress_text {
                      styles ["sub"]
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                    }
                  }

                  Box vm_boot_watch_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label vm_boot_watch_title {
                        styles ["label"]
                        label: _("Watch the installation");
                        xalign: 0;
                        wrap: true;
                      }

                      Label vm_boot_watch_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_boot_console {
                      styles ["outlined"]
                      name: "boot_console";
                      label: _("Open");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Stop");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Stops the guest; the disk is kept.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_boot_stop {
                      styles ["outlined"]
                      name: "boot_stop";
                      label: _("Stop");
                      valign: center;
                    }
                  }
                }

                Label vm_boot_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: stopped ── installed, and off
        StackPage {
          name: "stopped";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_ready_summary {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Start");
                        xalign: 0;
                      }

                      Label vm_start_note {
                        styles ["sub"]
                        label: _("Ready in a minute or two.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_start {
                      styles ["suggested-action"]
                      name: "start";
                      label: _("Start");
                      valign: center;
                    }
                  }
                }

                Label vm_start_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[RESOURCES]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label {
                    styles ["section-meta"]
                    label: _("From the next start");
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Label {
                      styles ["label"]
                      label: _("Memory (GiB)");
                      hexpand: true;
                      xalign: 0;
                      valign: center;
                    }

                    SpinButton vm_ready_memory {
                      adjustment: Adjustment {
                        lower: 2;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 4;
                        value: 8;
                      };
                      numeric: true;
                      width-chars: 4;
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Label {
                      styles ["label"]
                      label: _("CPU cores");
                      hexpand: true;
                      xalign: 0;
                      valign: center;
                    }

                    SpinButton vm_ready_cpus {
                      adjustment: Adjustment {
                        lower: 1;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 2;
                        value: 4;
                      };
                      numeric: true;
                      width-chars: 4;
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Disk size");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Set when the machine was made. A larger disk needs its partition enlarged inside the guest.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Label vm_disk_size {
                      styles ["readout"]
                      valign: center;
                    }
                  }
                }

                Box {
                  styles ["actions"]
                  halign: end;

                  Button vm_ready_save {
                    styles ["outlined"]
                    name: "ready_save";
                    label: _("Apply");
                  }
                }

                Label vm_ready_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[REMOVE]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box vm_remove_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Remove the container");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Its container and settings go. The disk and its password stay, so installing again starts from them.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_remove {
                      styles ["outlined"]
                      name: "remove";
                      label: _("Remove…");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Delete the disk");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("The installed system and its files, for good. The machine stays, to install again.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_remove_data {
                      styles ["outlined", "danger"]
                      name: "remove_data";
                      label: _("Delete…");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Delete the machine");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("The machine and all its files, for good.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_delete {
                      styles ["outlined", "danger"]
                      name: "delete";
                      label: _("Delete…");
                      valign: center;
                    }
                  }
                }

                Label vm_remove_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }

        // ── PAGE: running ── up: see it, or stop it
        StackPage {
          name: "running";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label: _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_run_summary {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body", "rows"]
                  orientation: vertical;

                  Box vm_run_watch_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label vm_run_watch_title {
                        styles ["label"]
                        xalign: 0;
                        wrap: true;
                      }

                      Label vm_run_watch_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_connect {
                      styles ["suggested-action"]
                      name: "connect";
                      label: _("Connect");
                      valign: center;
                    }
                  }

                  Box vm_run_console_row {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Web console");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("The guest's screen, in your browser.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_console_ready {
                      styles ["outlined"]
                      name: "console_ready";
                      label: _("Open");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label: _("Stop");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label: _("Stops the guest; the disk is kept.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_stop {
                      styles ["outlined"]
                      name: "stop";
                      label: _("Stop");
                      valign: center;
                    }
                  }
                }

                Label vm_run_error {
                  styles ["sub", "vm-error"]
                  xalign: 0;
                  wrap: true;
                  wrap-mode: word_char;
                  selectable: true;
                  visible: false;
                }
              }
            }
          };
        }
      }
    }
  }
}

// New machine, over the window, in two steps: what it is (the system, how it
// runs, its name), then what it gets (memory, CPU cores, disk). Go keeps the
// dialog and shows it again for the next one.
Window vm_new_dialog {
  styles ["app", "settings", "vm-dialog"]
  title: _("New machine");
  modal: true;
  hide-on-close: true;
  resizable: false;

  Box {
    styles ["page"]
    orientation: vertical;
    spacing: 10;
    width-request: 480;

    Label {
      styles ["vm-dialog-title"]
      label: _("New machine");
      xalign: 0;
    }

    Stack vm_new_steps {
      vhomogeneous: false;
      interpolate-size: true;
      transition-type: crossfade;

      StackPage {
        name: "what";
        child: Box {
          orientation: vertical;
          spacing: 10;

          Label {
            styles ["sub"]
            label: _("Pick the system, how it runs, and a name.");
            xalign: 0;
            wrap: true;
          }

          Label {
            styles ["label"]
            label: _("System");
            xalign: 0;
            margin-top: 8;
          }

          // Go appends a choice per system, its mark before its name.
          Box vm_new_systems {
            spacing: 6;
            homogeneous: true;
          }

          Label {
            styles ["label"]
            label: _("How it runs");
            xalign: 0;
            margin-top: 8;
          }

          // Go appends a row per template, and shows those of the chosen system.
          ListBox vm_templates {
            styles ["vm-templates"]
            selection-mode: single;
            activate-on-single-click: true;
          }

          Box {
            styles ["field"]
            orientation: vertical;
            spacing: 6;
            margin-top: 6;

            Label {
              styles ["label"]
              label: _("Machine name");
              xalign: 0;
            }

            Entry vm_new_name {
              placeholder-text: _("windows");
            }

            Label vm_new_note {
              styles ["sub"]
              label: _("Its folder is named after it.");
              xalign: 0;
              wrap: true;
            }
          }

          Label vm_create_error {
            styles ["sub", "vm-error"]
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            selectable: true;
            visible: false;
          }
        };
      }

      StackPage {
        name: "resources";
        child: Box {
          orientation: vertical;

          Label {
            styles ["sub"]
            label: _("What it gets from this computer. Memory and CPU cores can change later.");
            xalign: 0;
            wrap: true;
            margin-bottom: 8;
          }

          Box {
            styles ["rows"]
            orientation: vertical;

        Box {
          styles ["row"]
          spacing: 16;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;
            spacing: 2;

            Label {
              styles ["label"]
              label: _("Memory (GiB)");
              xalign: 0;
            }

            Label vm_new_memory_sub {
              styles ["sub"]
              xalign: 0;
            }
          }

          SpinButton vm_new_memory {
            adjustment: Adjustment {
              lower: 2;
              upper: 256;
              step-increment: 1;
              page-increment: 4;
              value: 8;
            };
            numeric: true;
            width-chars: 4;
            valign: center;
          }
        }

        Box {
          styles ["row"]
          spacing: 16;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;
            spacing: 2;

            Label {
              styles ["label"]
              label: _("CPU cores");
              xalign: 0;
            }

            Label vm_new_cpus_sub {
              styles ["sub"]
              xalign: 0;
            }
          }

          SpinButton vm_new_cpus {
            adjustment: Adjustment {
              lower: 1;
              upper: 256;
              step-increment: 1;
              page-increment: 2;
              value: 4;
            };
            numeric: true;
            width-chars: 4;
            valign: center;
          }
        }

        Box {
          styles ["row"]
          spacing: 16;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;
            spacing: 2;

            Label {
              styles ["label"]
              label: _("Disk size (GiB)");
              xalign: 0;
            }

            Label vm_new_disk_sub {
              styles ["sub"]
              xalign: 0;
            }
          }

          SpinButton vm_new_disk {
            adjustment: Adjustment {
              lower: 8;
              upper: 2048;
              step-increment: 8;
              page-increment: 64;
              value: 64;
            };
            numeric: true;
            width-chars: 4;
            valign: center;
          }
        }
          }
        };
      }
    }

    Box {
      spacing: 8;
      margin-top: 8;

      Label vm_create_note {
        styles ["sub"]
        label: _("Writes the machine's definition. Nothing is installed or started yet.");
        hexpand: true;
        xalign: 0;
        wrap: true;
        visible: false;
      }

      // Holds the buttons at the end while the note is hidden.
      Box {
        hexpand: true;
        visible: bind vm_create_note.visible inverted;
      }

      Button vm_new_cancel {
        styles ["outlined"]
        name: "new_cancel";
        label: _("Cancel");
        valign: center;
      }

      Button vm_new_back {
        styles ["outlined"]
        name: "new_back";
        label: _("Back");
        valign: center;
        visible: false;
      }

      Button vm_new_next {
        styles ["suggested-action"]
        name: "new_next";
        label: _("Next");
        valign: center;
      }

      Button vm_create {
        styles ["suggested-action"]
        name: "create_machine";
        label: _("Create");
        valign: center;
        visible: false;
      }
    }
  }
}
