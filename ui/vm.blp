// Virtual machines: manages machines, one folder each. The window lists them
// on the left and shows the chosen machine's page on the right; Go switches
// between the pages as the machine's state changes.
//
//   empty        — no machine yet; New makes one from a template
//   new          — naming a machine and picking its template
//   unavailable  — this build has no backend for the machine's kind
//   console      — only a serial console: its debugger and its output
//   prereq       — some host requirement is missing; shows what and why
//   setup        — environment is ready; nothing installed yet
//   provisioning — first-time install (download / setup)
//   starting     — the guest is installed and coming up
//   stopped      — the guest is installed and off
//   running      — the guest is up; connect or stop
//
// None of the pages show controls that belong to a different stage.
using Gtk 4.0;

ApplicationWindow vm {
  styles ["settings", "vmpage"]
  title:  _("Virtual machines");
  default-width: 880;
  default-height: 680;

  Box {
    orientation: horizontal;

    // ── the machines, one a row ───────────────────────────────────────────
	Box {
	  styles ["vm-index"]
	  orientation: vertical;
	  width-request: 296;

	  Box {
	    styles ["vm-index-head"]
	    spacing: 8;

	    Label {
	      styles ["vm-index-title"]
	      label:  _("Virtual machines");
	      hexpand: true;
	      xalign: 0;
	    }

	    Button vm_new {
	      styles ["outlined"]
	      name: "new_machine";
	      label:  _("New");
	      tooltip-text: _("Add a machine from a template");
	    }
	  }

	  ScrolledWindow {
	    vexpand: true;
	    hscrollbar-policy: never;
	    ListBox vm_machines {
	      styles ["vm-machines"]
	      selection-mode: single;
	      activate-on-single-click: true;
	    }
	  }

	  Label vm_fault_heading {
	    styles ["section-label"]
	    label:  _("Needs recovery");
	    xalign: 0;
	    margin-start: 12;
	    margin-top: 8;
	    visible: false;
	  }

	  ScrolledWindow vm_fault_scroll {
	    max-content-height: 140;
	    hscrollbar-policy: never;
	    visible: false;
	    ListBox vm_faults {
	      styles ["vm-machines"]
	      selection-mode: single;
	      activate-on-single-click: true;
	    }
	  }
	}

	Separator { orientation: vertical; }

	Box {
	  orientation: vertical;
	  hexpand: true;
      // ── headline ─────────────────────────────────────────────────────────
      Box {
        styles ["vm-head"]
        spacing: 12;

        Box {
          orientation: vertical;
          hexpand: true;
          valign: center;
          spacing: 2;

          Label vm_title {
            styles ["vm-title"]
            label:  _("Virtual machines");
            xalign: 0;
          }

          Label vm_sub {
            styles ["sub"]
            xalign: 0;
            ellipsize: end;
          }
        }
      }

      // ── the pages: the machine's stage, or making a new one ──────────────
      Stack vm_stack {
        vexpand: true;
        transition-type: crossfade;
        transition-duration: 140;

        StackPage {
	name: "fault";
	child: Box {
	  orientation: vertical;
	  valign: center;
	  margin-start: 24;
	  margin-end: 24;
	  spacing: 12;
	  Label vm_fault_error {
	    styles ["sub"]
	    xalign: 0;
	    wrap: true;
	  }
	  Label {
	    styles ["sub"]
	    label:  _("This machine folder cannot be loaded. Deleting it permanently removes all files inside.");
	    xalign: 0;
	    wrap: true;
	  }
	  Button vm_fault_delete {
	    styles ["destructive-action"]
	    name: "fault_delete";
	    label:  _("Delete folder");
	    halign: end;
	  }
	};
        }

        // ── PAGE: empty ── nothing made yet ────────────────────────────────
        StackPage {
          name: "empty";
          child: Box {
            orientation: vertical;
            valign: center;
            halign: center;
            spacing: 8;
            margin-start: 24;
            margin-end: 24;

            Image {
              styles ["vm-empty-mark"]
              icon-name: "vm-machine-symbolic";
              pixel-size: 48;
            }

            Label {
              styles ["vm-empty-title"]
              label:  _("No machines yet");
            }

            Label {
              styles ["sub"]
              label:  _("New picks an operating system; the machine's fields follow.");
              justify: center;
              wrap: true;
            }
          };
        }

        // ── PAGE: new ── a template to start from ──────────────────────────
        StackPage {
          name: "new";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[TEMPLATE]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // The templates scroll on their own: the name and Create
                  // stay in reach whatever the window's height is.
                  ScrolledWindow {
                    hscrollbar-policy: never;
                    vexpand: true;
                    height-request: 272;

                    // Go appends one row per template.
                    ListBox vm_templates {
                      styles ["rows", "vm-templates"]
                      selection-mode: single;
                      activate-on-single-click: true;
                    }
                  }
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[NAME]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Machine name");
                        xalign: 0;
                      }

                      Label vm_new_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                        label:  _("The folder and the container are named after it.");
                      }
                    }

                    Entry vm_new_name {
                      styles ["entry"]
                      placeholder-text: _("windows");
                      width-chars: 18;
                      valign: center;
                    }
                  }
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Create");
                        xalign: 0;
                      }

                      Label vm_create_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                        label:  _("Writes the machine's definition. Nothing is installed or started yet.");
                      }
                    }

                    Button vm_create {
                      styles ["suggested"]
                      name: "create_machine";
                      label:  _("Create");
                      valign: center;
                    }
                  }
                }
              }
            }
          };
        }

        // ── PAGE: unavailable ── this build cannot run the machine ─────────
        StackPage {
          name: "unavailable";
          child: Box {
            orientation: vertical;
            valign: center;
            halign: center;
            spacing: 8;
            margin-start: 24;
            margin-end: 24;

            Image {
              styles ["vm-empty-mark"]
              icon-name: "dialog-warning-symbolic";
              pixel-size: 48;
            }

            Label {
              styles ["vm-empty-title"]
              label:  _("No backend for this machine");
            }

            Label vm_na_note {
              styles ["sub"]
              justify: center;
              wrap: true;
            }
          };
        }

        // ── PAGE: console ── a machine's serial console and its debugger ──────
        StackPage {
          name: "console";
          child: Box {
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[CONSOLE]");
                  hexpand: true;
                  xalign: 0;
                }

                Button vm_console_back {
                  styles ["outlined"]
                  name: "console_back";
                  label:  _("Back");
                  valign: center;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Label vm_console_summary {
                  styles ["label"]
                  xalign: 0;
                }

                Label vm_console_hardware {
                  styles ["sub"]
                  xalign: 0;
                  wrap: true;
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Wait for a debugger");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Holds the guest at its first instruction, for gdb on 127.0.0.1:1234.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Switch vm_console_gdb {
                    name: "console_gdb";
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Debugger");
                      xalign: 0;
                    }

                    Label vm_console_cmd {
                      styles ["sub", "vm-console-cmd"]
                      xalign: 0;
                      wrap: true;
                      selectable: true;
                    }
                  }

                  Button vm_console_copy {
                    styles ["outlined"]
                    name: "console_copy";
                    label:  _("Copy");
                    valign: center;
                  }
                }
              }
            }

            // — serial section: the guest's own output, one line at a time —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[SERIAL]");
                  hexpand: true;
                  xalign: 0;
                }

                Button vm_console_start {
                  styles ["suggested-action"]
                  name: "console_start";
                  label:  _("Start");
                  valign: center;
                }

                Button vm_console_stop {
                  styles ["outlined"]
                  name: "console_stop";
                  label:  _("Stop");
                  valign: center;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                // The output is the one thing that grows with the window; it
                // scrolls, and Go appends each line as the guest writes it.
                ScrolledWindow {
                  vexpand: true;
                  height-request: 320;
                  hscrollbar-policy: never;

                  TextView vm_serial {
                    styles ["vm-console"]
                    editable: false;
                    cursor-visible: false;
                    wrap-mode: word_char;
                    top-margin: 10;
                    bottom-margin: 10;
                    left-margin: 12;
                    right-margin: 12;
                  }
                }
              }
            }
          };
        }

        // ── PAGE: prereq ── one or more host requirements are missing ─────
        StackPage {
          name: "prereq";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              orientation: vertical;

              // What is wrong and how to fix it.
              Box vm_prereq_list {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[HOST]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // Go appends one .vm-check-row per check.
                  Box vm_check_rows {
                    styles ["rows", "vm-check-rows"]
                    orientation: vertical;
                  }
                }
              }

              // Asking for help is the assistant's job, not the window's: inua
              // itself runs no package manager and no privileged install.
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[ASSISTANT]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Ask the assistant to fix this");
                        xalign: 0;
                      }

                      Label vm_assistant_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                        label:  _("It checks what is missing, says what it would change, and runs it with its own approval.");
                      }
                    }

                    Button vm_assistant_ask {
                      styles ["suggested-action"]
                      name: "assistant_ask";
                      label:  _("Ask the assistant");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Check again");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Reads the host again, after the assistant has changed something.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_assistant_recheck {
                      styles ["outlined"]
                      name: "assistant_recheck";
                      label:  _("Check again");
                      valign: center;
                    }
                  }
                }
              }
            }
          };
        }

        // ── PAGE: setup ── ready to install ────────────────────────────────
        StackPage {
          name: "setup";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              orientation: vertical;

              // — profile section —
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_setup_summary {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // Recommended profile row
                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Recommended profile");
                        xalign: 0;
                      }

                      Label vm_profile_desc {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_accept {
                      styles ["outlined"]
                      name: "accept";
                      label:  _("Use it");
                      valign: center;
                    }
                  }

                  // Advanced editor (collapsed)
                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Advanced configuration");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Set memory, CPU cores and disk size yourself.");
                        xalign: 0;
                      }
                    }

                    Button vm_advanced_toggle {
                      styles ["outlined"]
                      name: "advanced_toggle";
                      label:  _("Edit");
                      valign: center;
                    }
                  }

                  Revealer vm_advanced {
                    reveal-child: false;
                    transition-type: slide_down;
                    transition-duration: 180;

                    Box {
                      orientation: vertical;

                      Box {
                        styles ["field"]

                        Label {
                          styles ["label"]
                          label:  _("Memory (MiB)");
                          hexpand: true;
                          xalign: 0;
                          valign: center;
                        }

                        SpinButton vm_memory {
                          adjustment: Adjustment {
                            lower: 2048;
                            upper: 262144;
                            step-increment: 1024;
                            page-increment: 4096;
                            value: 8192;
                          };
                          numeric: true;
                          width-chars: 7;
                          valign: center;
                        }
                      }

                      Box {
                        styles ["field"]

                        Label {
                          styles ["label"]
                          label:  _("CPU cores");
                          hexpand: true;
                          xalign: 0;
                          valign: center;
                        }

                        SpinButton vm_cpus {
                          adjustment: Adjustment {
                            lower: 1;
                            upper: 256;
                            step-increment: 1;
                            page-increment: 2;
                            value: 4;
                          };
                          numeric: true;
                          width-chars: 4;
                          valign: center;
                        }
                      }

                      Box {
                        styles ["field"]

                        Label {
                          styles ["label"]
                          label:  _("Disk size (GiB)");
                          hexpand: true;
                          xalign: 0;
                          valign: center;
                        }

                        SpinButton vm_disk {
                          adjustment: Adjustment {
                            lower: 32;
                            upper: 2048;
                            step-increment: 16;
                            page-increment: 64;
                            value: 128;
                          };
                          numeric: true;
                          width-chars: 5;
                          valign: center;
                        }
                      }

                    }
                  }
                }
              }

              // — install section —
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[INSTALL]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Install the system");
                        xalign: 0;
                      }

                      // The sentence itself is Go's, because it is not the
                      // same for a system installed from its own media and one
                      // a container installs for you.
                      Label vm_setup_note {
                        styles ["sub"]
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_install {
                      styles ["suggested-action"]
                      name: "install";
                      label:  _("Install");
                      valign: center;
                    }
                  }
                }
              }

              // — install image — the media a QEMU machine installs from —
              // The list is osinfo-db's catalog; Go appends a row per medium.
              Box vm_setup_media {
                styles ["section"]
                orientation: vertical;
                visible: false;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[IMAGE]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_media_source {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Label vm_media_note {
                    styles ["sub"]
                    xalign: 0;
                    wrap: true;
                  }

                  // The download in flight: how far it has got and the one
                  // button that stops it. It stands above the list, so that
                  // starting a download does not move its own progress to the
                  // far end of two hundred rows.
                  Box vm_media_progress {
                    styles ["row"]
                    visible: false;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 4;

                      ProgressBar vm_iso_progress {
                        show-text: false;
                        hexpand: true;
                      }

                      Label vm_iso_progress_text {
                        styles ["sub"]
                        xalign: 0;
                      }
                    }

                    Button vm_iso_cancel {
                      styles ["outlined"]
                      name: "iso_cancel";
                      label:  _("Cancel");
                      valign: center;
                    }
                  }

                  // What the list is showing: the systems and images it is
                  // searched for, the platform and the architecture it is
                  // limited to, and the two switches that offer what the
                  // guide's rule otherwise leaves out.
                  Box vm_media_filters {
                    styles ["row", "vm-media-filters"]

                    Entry vm_iso_search {
                      styles ["vm-iso-search"]
                      hexpand: true;
                      valign: center;
                      placeholder-text:  _("Search systems and images");
                    }

                    DropDown vm_iso_platform {
                      styles ["vm-iso-filter"]
                      valign: center;
                      tooltip-text:  _("Which platform to show");
                    }

                    DropDown vm_iso_arch {
                      styles ["vm-iso-filter"]
                      valign: center;
                      tooltip-text:  _("Which architecture to show");
                    }

                    Box {
                      styles ["vm-iso-switch"]

                      Label {
                        styles ["sub"]
                        valign: center;
                        label:  _("Prerelease");
                      }

                      Switch vm_iso_prerelease {
                        valign: center;
                        tooltip-text:  _("Also show prerelease and development systems");
                      }
                    }

                    Box {
                      styles ["vm-iso-switch"]

                      Label {
                        styles ["sub"]
                        valign: center;
                        label:  _("Ended");
                      }

                      Switch vm_iso_eol {
                        valign: center;
                        tooltip-text:  _("Also show systems past their support date");
                      }
                    }
                  }

                  // What the filters left, in the systems-and-media the list
                  // counts in: "12 systems · 31 images".
                  Label vm_media_count {
                    styles ["sub", "vm-media-count"]
                    xalign: 0;
                  }

                  // The systems worth offering first, by the database's own
                  // distribution ids: Go appends one row each, at most eight.
                  Label {
                    styles ["vm-media-group"]
                    xalign: 0;
                    label:  _("Recommended");
                  }

                  Box vm_media_recommended {
                    styles ["vm-media-rows"]
                    orientation: vertical;
                    spacing: 2;
                  }

                  // Everything the filters left, one row per system, each
                  // holding its own media.
                  Label {
                    styles ["vm-media-group"]
                    xalign: 0;
                    label:  _("All systems");
                  }

                  Box vm_media_rows {
                    styles ["vm-media-rows"]
                    orientation: vertical;
                    spacing: 2;
                  }
                }
              }

              Box vm_setup_disk {
                styles ["section"]
                orientation: vertical;
                visible: false;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[DISK]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Previous files");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Permanently deletes leftover install files. Cannot be undone.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_setup_remove_data {
                      styles ["destructive-action"]
                      name: "setup_remove_data";
                      label:  _("Delete disk");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Delete machine");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Removes the machine and its files. Cannot be undone.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_setup_delete {
                      styles ["destructive-action"]
                      name: "setup_delete";
                      label:  _("Delete");
                      valign: center;
                    }
                  }
                }
              }
            }
          };
        }

        // ── PAGE: provisioning ── downloading / first-time install ────────
        StackPage {
          name: "provisioning";
          child: Box {
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[PROGRESS]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["row"]
                  orientation: vertical;
                  spacing: 10;

                  ProgressBar vm_progress {
                    show-text: false;
                  }

                  Label vm_progress_text {
                    styles ["sub"]
                    xalign: 0;
                    wrap: true;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Watch the installation");
                      xalign: 0;
                    }

                    Label vm_prov_console_note {
                      styles ["sub"]
                      label:  _("The installer screen is in your browser. The web console on 127.0.0.1:8006 has no login of its own.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_console {
                    styles ["outlined"]
                    name: "console";
                    label:  _("Open web console");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Continue installation");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Starts the container; Windows installs itself inside it.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_prov_start {
                    styles ["suggested-action"]
                    name: "prov_start";
                    label:  _("Continue");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Stop waiting");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Stops the container; the disk is kept. Reopen to resume.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_prov_stop {
                    styles ["outlined"]
                    name: "prov_stop";
                    label:  _("Stop");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Abandon installation");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Removes the project so you can start over. Downloaded files stay.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_prov_remove {
                    styles ["outlined"]
                    name: "prov_remove";
                    label:  _("Remove");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Delete machine");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Permanently deletes the machine and all its files.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_prov_delete {
                    styles ["destructive-action"]
                    name: "prov_delete";
                    label:  _("Delete");
                    valign: center;
                  }
                }
              }
            }
          };
        }

        // ── PAGE: starting ── installed guest is coming up ───────────────
        StackPage {
          name: "starting";
          child: Box {
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[PROGRESS]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["row"]
                  orientation: vertical;
                  spacing: 10;

                  ProgressBar vm_boot_progress {
                    show-text: false;
                  }

                  Label vm_boot_progress_text {
                    styles ["sub"]
                    xalign: 0;
                    wrap: true;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Web console");
                      xalign: 0;
                    }

                    Label vm_boot_console_note {
                      styles ["sub"]
                      label:  _("The guest screen is in your browser until RDP is ready.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_boot_console {
                    styles ["outlined"]
                    name: "boot_console";
                    label:  _("Open web console");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Stop");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Stops the guest; the disk is kept.");
                      xalign: 0;
                    }
                  }

                  Button vm_boot_stop {
                    styles ["outlined"]
                    name: "boot_stop";
                    label:  _("Stop");
                    valign: center;
                  }
                }
              }
            }
          };
        }

        // ── PAGE: stopped ── Windows is installed and the guest is off ──
        StackPage {
          name: "stopped";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              orientation: vertical;

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[GUEST]");
                    hexpand: true;
                    xalign: 0;
                  }

                  Label vm_ready_summary {
                    styles ["section-meta"]
                    xalign: 1;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["field"]

                    Label {
                      styles ["label"]
                      label:  _("Memory (MiB)");
                      hexpand: true;
                      xalign: 0;
                      valign: center;
                    }

                    Box {
                      orientation: vertical;
                      valign: center;
                      spacing: 2;

                      SpinButton vm_ready_memory {
                        adjustment: Adjustment {
                          lower: 2048;
                          upper: 262144;
                          step-increment: 1024;
                          page-increment: 4096;
                          value: 8192;
                        };
                        numeric: true;
                        width-chars: 7;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Takes effect on next start.");
                        xalign: 1;
                      }
                    }
                  }

                  Box {
                    styles ["field"]

                    Label {
                      styles ["label"]
                      label:  _("CPU cores");
                      hexpand: true;
                      xalign: 0;
                      valign: center;
                    }

                    Box {
                      orientation: vertical;
                      valign: center;
                      spacing: 2;

                      SpinButton vm_ready_cpus {
                        adjustment: Adjustment {
                          lower: 1;
                          upper: 256;
                          step-increment: 1;
                          page-increment: 2;
                          value: 4;
                        };
                        numeric: true;
                        width-chars: 4;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Takes effect on next start.");
                        xalign: 1;
                      }
                    }
                  }

                  Box {
                    styles ["field"]

                    Label {
                      styles ["label"]
                      label:  _("Disk size (GiB)");
                      hexpand: true;
                      xalign: 0;
                      valign: center;
                    }

                    Box {
                      orientation: vertical;
                      valign: center;
                      spacing: 2;

                      Label vm_disk_size {
                        styles ["readout"]
                        xalign: 1;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Enlarging needs a manual partition resize inside Windows.");
                        xalign: 1;
                        wrap: true;
                      }
                    }
                  }

                  Box {
                    styles ["row"]
                    halign: end;

                    Button vm_ready_save {
                      styles ["outlined"]
                      name: "ready_save";
                      label:  _("Apply");
                      valign: center;
                    }
                  }
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[ACTIONS]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Start");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Starts the guest; ready in a minute or two.");
                        xalign: 0;
                      }
                    }

                    Button vm_start {
                      styles ["suggested-action"]
                      name: "start";
                      label:  _("Start");
                      valign: center;
                    }
                  }
                }
              }

              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    label:  _("[REMOVE]");
                    hexpand: true;
                    xalign: 0;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Remove VM");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Deletes the container and project. The disk and its password stay.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_remove {
                      styles ["outlined"]
                      name: "remove";
                      label:  _("Remove");
                      valign: center;
                    }
                  }

                  Box {
                    styles ["row"]

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;
                      spacing: 2;

                      Label {
                        styles ["label"]
                        label:  _("Delete disk data");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("Permanently deletes the Windows disk. Cannot be undone.");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button vm_remove_data {
                      styles ["destructive-action"]
                      name: "remove_data";
                      label:  _("Delete");
                      valign: center;
                    }
                  }
                }
              }
            }
          };
        }

        // ── PAGE: running ── Windows is up ────────────────────────────────
        StackPage {
          name: "running";
          child: Box {
            orientation: vertical;

            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Box {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[GUEST]");
                  hexpand: true;
                  xalign: 0;
                }

                Label vm_run_summary {
                  styles ["section-meta"]
                  xalign: 1;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Connect");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Opens FreeRDP.");
                      xalign: 0;
                    }
                  }

                  Button vm_connect {
                    styles ["suggested-action"]
                    name: "connect";
                    label:  _("Connect");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Web console");
                      xalign: 0;
                    }

                    Label vm_ready_console_note {
                      styles ["sub"]
                      label:  _("The guest screen in the browser.");
                      xalign: 0;
                    }
                  }

                  Button vm_console_ready {
                    styles ["outlined"]
                    name: "console_ready";
                    label:  _("Open web console");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Stop");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Stops the guest; the disk is kept.");
                      xalign: 0;
                    }
                  }

                  Button vm_stop {
                    styles ["outlined"]
                    name: "stop";
                    label:  _("Stop");
                    valign: center;
                  }
                }
              }
            }
          };
        }
      }
    }
  }
}
