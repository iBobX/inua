// Mail's composer: a window of its own. From (the account), To, Cc and
// Bcc, the subject, the text, the files attached, the assistant's row,
// and Send. The account list and the attachments are filled in Go.
using Gtk 4.0;

Window compose {
  styles ["settings", "mail", "mail-compose"]
  title: _("New message");
  default-width: 760;
  default-height: 700;

  Box {
    orientation: vertical;

    // The fields; the suggestions for an address open under its row.
    Box fields {
      styles ["mail-compose-fields"]
      orientation: vertical;

      Box {
        styles ["mail-field"]

        Label {
          styles ["mail-field-label"]
          label: _("From");
          xalign: 0;
        }

        DropDown from {
          styles ["mail-from"]
          hexpand: true;
        }
      }

      Box to_row {
        styles ["mail-field"]

        Label {
          styles ["mail-field-label"]
          label: _("To");
          xalign: 0;
        }

        Entry to {
          styles ["mail-field-entry"]
          hexpand: true;
        }

        Button show_cc {
          styles ["mail-plain"]
          label: _("Cc, Bcc");
        }
      }

      Box cc_row {
        styles ["mail-field"]
        visible: false;

        Label {
          styles ["mail-field-label"]
          label: _("Cc");
          xalign: 0;
        }

        Entry cc {
          styles ["mail-field-entry"]
          hexpand: true;
        }
      }

      Box bcc_row {
        styles ["mail-field"]
        visible: false;

        Label {
          styles ["mail-field-label"]
          label: _("Bcc");
          xalign: 0;
        }

        Entry bcc {
          styles ["mail-field-entry"]
          hexpand: true;
        }
      }

      Box {
        styles ["mail-field"]

        Label {
          styles ["mail-field-label"]
          label: _("Subject");
          xalign: 0;
        }

        Entry subject {
          styles ["mail-field-entry", "mail-subject"]
          hexpand: true;
        }
      }
    }

    ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      TextView body {
        styles ["mail-body"]
        wrap-mode: word_char;
        top-margin: 18;
        bottom-margin: 18;
        left-margin: 28;
        right-margin: 28;
      }
    }

    // The files attached, as chips; Go fills it.
    FlowBox attachments {
      styles ["mail-attachments"]
      selection-mode: none;
      max-children-per-line: 6;
      visible: false;
    }

    // The assistant's row: what to say, then Draft; or Polish the text.
    Box {
      styles ["mail-assist"]
      spacing: 10;

      Label {
        styles ["kicker", "mail-assist-kicker"]
        label: _("ASSISTANT");
      }

      Entry draft_what {
        styles ["mail-draft-what"]
        hexpand: true;
        placeholder-text: _("What to say: the assistant drafts it");
      }

      Button draft {
        styles ["mail-plain"]
        label: _("Draft");
      }

      MenuButton polish {
        styles ["mail-plain"]
        label: _("Polish");
        direction: up;
      }

      Button undo_ai {
        styles ["mail-plain"]
        label: _("Undo");
        visible: false;
      }
    }

    Label ai_note {
      styles ["sub", "mail-ai-note"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Box {
      styles ["mail-compose-foot"]
      spacing: 8;

      Label status {
        styles ["sub", "mail-compose-status"]
        xalign: 0;
        hexpand: true;
        wrap: true;
      }

      Button attach {
        styles ["outlined"]
        label: _("Attach…");
      }

      Button send {
        styles ["suggested-action", "mail-send"]
        label: _("Send");
        tooltip-text: _("Ctrl+Enter");
      }
    }
  }
}
