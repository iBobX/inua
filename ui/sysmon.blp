// System Monitor: three tabs. Overview: CPU (each core too), memory, GPU,
// network, disk and battery, the busy ones with their last minute drawn.
// Processes: the running ones by CPU, memory or name; one opens its
// details and the ways to end it in a panel at the right. System: the computer, its processor,
// graphics, storage, network and sensors. Go fills them.
using Gtk 4.0;

ApplicationWindow sysmon {
  default-width: 460;
  default-height: 680;

  // The tabs, and the open process beside them.
  Box {
    Box {
      styles ["sysmonapp"]
      orientation: vertical;
      width-request: 460;

      StackSwitcher {
        styles ["tabs"]
        stack: pages;
        halign: center;
      }

      Stack pages {
        vexpand: true;
        transition-type: crossfade;
        transition-duration: 140;

        StackPage {
          name: "overview";
          title: _("OVERVIEW");

          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box meters {
              styles ["list", "meters"]
              orientation: vertical;
            }
          };
        }

        StackPage {
          name: "processes";
          title: _("PROCESSES");

          child: Box {
            orientation: vertical;

            Box {
              styles ["bar"]

              Label proc_count {
                styles ["kicker"]
                hexpand: true;
                xalign: 0;
              }

              Box {
                styles ["segmented", "linked"]

                ToggleButton by_cpu {
                  label: _("CPU");
                  active: true;
                }

                ToggleButton by_mem {
                  label: _("Memory");
                  group: by_cpu;
                }

                ToggleButton by_name {
                  label: _("Name");
                  group: by_cpu;
                }
              }
            }

            // Only the processes whose name, PID or user has this in it.
            Box {
              styles ["composer"]

              SearchEntry filter {
                hexpand: true;
                placeholder-text: _("Filter by name, PID or user");
              }
            }

            Label proc_note {
              styles ["proc-note"]
              visible: false;
              xalign: 0;
              wrap: true;
            }

            ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Box procs {
                styles ["list", "rows"]
                orientation: vertical;
              }
            }
          };
        }

        StackPage {
          name: "system";
          title: _("SYSTEM");

          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box system {
              styles ["list", "system"]
              orientation: vertical;
            }
          };
        }
      }
    }

    // The open process: a panel sliding in at the right.
    Revealer detail_reveal {
      transition-type: slide_left;
      transition-duration: 200;

      Box {
        styles ["sysmonapp", "proc-panel"]
        orientation: vertical;
        width-request: 380;

        Box {
          styles ["bar", "detail-bar"]
          spacing: 8;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;

            Label detail_name {
              styles ["detail-name"]
              xalign: 0;
              ellipsize: end;
            }

            Label detail_sub {
              styles ["kicker"]
              xalign: 0;
              ellipsize: end;
            }
          }

          Button back {
            styles ["plain"]
            icon-name: "window-close-symbolic";
            tooltip-text: _("Close (Escape)");
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box detail {
            styles ["list", "detail"]
            orientation: vertical;
          }
        }
      }
    }
  }
}
