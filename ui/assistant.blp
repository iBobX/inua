// The assistant (cmd/inua-assistant): who answers (a profile to switch
// to, when there are several), the conversation (your questions, a line
// for each thing it does, a card when it asks first, its answers as they
// arrive) and the question field, with the microphone for voice input. Go
// fills the conversation (internal/assistantui).
using Gtk 4.0;

ApplicationWindow assistant {
  default-width: 480;
  default-height: 700;

  Box {
    styles ["assistantapp"]
    orientation: vertical;

    Box {
      styles ["as-head"]
      spacing: 12;

      Box {
        orientation: vertical;
        hexpand: true;
        valign: center;
        spacing: 2;

        Label {
          styles ["as-title"]
          label:  _("Assistant");
          xalign: 0;
        }

        Label model {
          styles ["sub"]
          xalign: 0;
          ellipsize: end;
        }
      }

      // The profiles, when there are several: who answers this conversation.
      DropDown profile {
        valign: center;
        visible: false;
        tooltip-text:  _("Who answers");
      }

      Button settings {
        styles ["plain"]
        icon-name: "emblem-system-symbolic";
        tooltip-text:  _("AI settings");
        valign: center;
      }

      Button reset {
        styles ["plain"]
        icon-name: "list-add-symbolic";
        tooltip-text:  _("New conversation");
        valign: center;
      }
    }

    // Why it cannot answer: turned off, or no API key.
    Box notice_box {
      styles ["as-notice"]
      orientation: vertical;
      spacing: 10;
      visible: false;

      Label notice {
        xalign: 0;
        wrap: true;
      }

      Button open_settings {
        styles ["outlined"]
        label:  _("Open AI Settings");
        halign: start;
      }
    }

    ScrolledWindow scroll {
      vexpand: true;
      hscrollbar-policy: never;

      Box talk {
        styles ["as-talk"]
        orientation: vertical;
        spacing: 14;
      }
    }

    Box {
      styles ["as-composer"]
      orientation: vertical;
      spacing: 8;

      Box {
        spacing: 8;

        Entry question {
          hexpand: true;
          placeholder-text:  _("Ask, or tell me what to do");
        }

        // Voice input, in the question's place while it records (a red
        // mark, the time so far, the waveform) and while it is transcribed.
        Box voice_box {
          styles ["as-voice"]
          hexpand: true;
          spacing: 10;
          visible: false;

          Box voice_mark {
            styles ["rec-mark"]
            valign: center;
          }

          Label voice_time {
            styles ["as-voice-time"]
          }

          // The waveform, drawn by Go: how loud, the newest at the right.
          Box voice_wave {
            hexpand: true;
            valign: center;
          }

          Label voice_state {
            styles ["sub"]
            hexpand: true;
            xalign: 0;
            visible: false;
            label:  _("Transcribing…");
          }

          Button voice_discard {
            styles ["plain"]
            icon-name: "window-close-symbolic";
            tooltip-text:  _("Discard the recording");
            valign: center;
          }
        }

        // The microphone, when a profile transcribes; Stop while it records.
        Button voice {
          styles ["as-voice-button"]
          icon-name: "audio-input-microphone-symbolic";
          tooltip-text:  _("Voice input");
          visible: false;
        }

        Button send {
          styles ["suggested-action"]
          label:  _("Ask");
        }
      }

      Label voice_error {
        styles ["as-voice-error"]
        xalign: 0;
        wrap: true;
        selectable: true;
        visible: false;
      }
    }
  }
}
