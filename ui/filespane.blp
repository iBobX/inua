// One pane of Files: where it is (back, forward, up and the path as
// buttons, or an entry for typing one), the column heads that sort, the
// folder as a list or a grid (made in Go, internal/filesui/pane.go), and
// a status line. Loaded once for each pane.
using Gtk 4.0;

Box pane {
  styles ["files-pane"]
  orientation: vertical;
  hexpand: true;
  width-request: 320;

  Box {
    styles ["files-head"]
    spacing: 2;

    Button back {
      styles ["plain"]
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Back (Alt+←)");
    }

    Button forward {
      styles ["plain"]
      icon-name: "go-next-symbolic";
      tooltip-text: _("Forward (Alt+→)");
    }

    Button up {
      styles ["plain"]
      icon-name: "go-up-symbolic";
      tooltip-text: _("Parent folder (Alt+↑)");
    }

    Stack path_stack {
      hexpand: true;
      transition-type: crossfade;
      transition-duration: 100;

      StackPage {
        name: "crumbs";

        child: ScrolledWindow crumb_scroll {
          vscrollbar-policy: never;
          hscrollbar-policy: external;

          Box crumbs {
            styles ["files-crumbs"]
          }
        };
      }

      StackPage {
        name: "entry";

        child: Entry location {
          styles ["mono-entry", "files-location"]
          placeholder-text: _("A path, or a server: sftp://host/dir, smb://server/share");
        };
      }

      StackPage {
        name: "search";

        child: SearchEntry search {
          styles ["files-location"]
          placeholder-text: _("Search below this folder");
        };
      }
    }

    ToggleButton list_button {
      styles ["plain"]
      icon-name: "view-list-symbolic";
      tooltip-text: _("List (Ctrl+1)");
    }

    ToggleButton grid_button {
      styles ["plain"]
      icon-name: "view-grid-symbolic";
      tooltip-text: _("Grid (Ctrl+2)");
      group: list_button;
    }
  }

  // The list's column heads: a click sorts by the column, again reverses.
  Box columns {
    styles ["files-columns"]

    Button col_name {
      styles ["files-col"]
      hexpand: true;

      Label col_name_label {
        styles ["kicker"]
        xalign: 0;
      }
    }

    Button col_size {
      styles ["files-col", "files-col-size"]

      Label col_size_label {
        styles ["kicker"]
        xalign: 1;
      }
    }

    Button col_modified {
      styles ["files-col", "files-col-date"]

      Label col_modified_label {
        styles ["kicker"]
        xalign: 0;
      }
    }

    Button col_kind {
      styles ["files-col", "files-col-kind"]

      Label col_kind_label {
        styles ["kicker"]
        xalign: 0;
      }
    }
  }

  Stack views {
    vexpand: true;

    StackPage {
      name: "list";
      child: ScrolledWindow list_scroll {
        hscrollbar-policy: never;
      };
    }

    StackPage {
      name: "grid";
      child: ScrolledWindow grid_scroll {
        hscrollbar-policy: never;
      };
    }

    StackPage {
      name: "empty";
      child: Label empty_label {
        styles ["files-empty"]
        wrap: true;
        justify: center;
      };
    }
  }

  Box {
    styles ["files-status"]
    spacing: 12;

    Label filter_label {
      styles ["files-filter"]
      visible: false;
    }

    Label status_label {
      styles ["readout"]
      hexpand: true;
      xalign: 0;
      ellipsize: end;
    }

    Label free_label {
      styles ["readout"]
    }

    Button empty_trash {
      styles ["link", "files-empty-trash"]
      label: _("Empty Trash");
      visible: false;
    }
  }
}
