// One pane of Files: its tabs (shown with two or more), where it is (back,
// forward, up, the path as buttons or an entry, its path copied, a
// terminal there), the list or the grid (a segmented control), the column heads
// that sort (made in Go), the folder itself (internal/filesui/pane.go),
// and a status line with the zoom. Loaded once for each pane.
using Gtk 4.0;

Box pane {
  styles ["files-pane"]
  orientation: vertical;
  hexpand: true;
  width-request: 320;

  Box tabs {
    styles ["files-tabs"]
    visible: false;
  }

  Box {
    styles ["files-head"]
    spacing: 2;

    // With two panes: filled for the one the keys go to, hollow for the other.
    Box pane_mark {
      styles ["mark", "files-pane-mark"]
      valign: center;
      visible: false;
    }

    Button back {
      styles ["plain"]
      valign: center;
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Back (Alt+←)");
    }

    Button forward {
      styles ["plain"]
      valign: center;
      icon-name: "go-next-symbolic";
      tooltip-text: _("Forward (Alt+→)");
    }

    Button up {
      styles ["plain"]
      valign: center;
      icon-name: "go-up-symbolic";
      tooltip-text: _("Parent folder (Alt+↑)");
    }

    Stack path_stack {
      hexpand: true;
      transition-type: crossfade;
      transition-duration: 100;

      // A click beside the buttons edits the path.
      StackPage {
        name: "crumbs";

        child: ScrolledWindow crumb_scroll {
          vscrollbar-policy: never;
          hscrollbar-policy: external;

          Box crumbs {
            styles ["files-crumbs"]
          }
        };
      }

      StackPage {
        name: "entry";

        child: Entry location {
          styles ["mono-entry", "files-location"]
          placeholder-text: _("A path, or a remote disk: sftp://host/dir, smb://server/share");
        };
      }

      StackPage {
        name: "search";

        child: SearchEntry search {
          styles ["files-location"]
          placeholder-text: _("Search below this folder");
        };
      }
    }

    Button edit_path {
      styles ["plain"]
      valign: center;
      icon-name: "document-edit-symbolic";
      tooltip-text: _("Edit the path (Ctrl+L)");
    }

    Button copy_path {
      styles ["plain"]
      valign: center;
      icon-name: "edit-copy-symbolic";
      tooltip-text: _("Copy the path (Ctrl+Shift+C)");
    }

    Button terminal {
      styles ["plain"]
      valign: center;
      icon-name: "utilities-terminal-symbolic";
      tooltip-text: _("Terminal here (Ctrl+Alt+T)");
    }

    StackSwitcher view_switch {
      styles ["segmented", "icons"]
      stack: views;
      valign: center;
    }
  }

  // The list's column heads: a click sorts by the column, again reverses;
  // a right click, or the button at the end, chooses the columns.
  Box columns {
    styles ["files-columns"]
    spacing: 10;
  }

  Overlay {
    vexpand: true;

    child: Stack views {
      transition-type: crossfade;
      transition-duration: 100;

      StackPage {
        name: "list";
        title: _("List (Ctrl+1)");
        icon-name: "view-list-symbolic";

        child: ScrolledWindow list_scroll {
          hscrollbar-policy: never;
        };
      }

      StackPage {
        name: "grid";
        title: _("Grid (Ctrl+2)");
        icon-name: "view-grid-symbolic";

        child: ScrolledWindow grid_scroll {
          hscrollbar-policy: never;
        };
      }
    };

    // Why there is nothing to show, over the empty view.
    [overlay]
    Label empty_label {
      styles ["files-empty"]
      wrap: true;
      justify: center;
      halign: center;
      valign: center;
      can-target: false;
      visible: false;
    }
  }

  Box {
    styles ["files-status"]
    spacing: 12;

    Label filter_label {
      styles ["files-filter"]
      visible: false;
    }

    Label status_label {
      styles ["readout"]
      hexpand: true;
      xalign: 0;
      ellipsize: end;
    }

    Button empty_trash {
      styles ["link", "files-empty-trash"]
      label: _("Empty Trash");
      visible: false;
    }

    Label free_label {
      styles ["readout"]
    }

    Box {
      styles ["files-zoom"]

      Button zoom_out {
        styles ["plain"]
        valign: center;
        icon-name: "zoom-out-symbolic";
        tooltip-text: _("Smaller (Ctrl+−)");
      }

      Button zoom_level {
        styles ["link", "files-zoom-level"]
        tooltip-text: _("Normal size (Ctrl+0)");
      }

      Button zoom_in {
        styles ["plain"]
        valign: center;
        icon-name: "zoom-in-symbolic";
        tooltip-text: _("Bigger (Ctrl++)");
      }
    }
  }
}
