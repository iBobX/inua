// inua-term's window (docs/terminal.md): the workspaces, the shown
// workspace's sessions and their panes, and the shown session's
// terminals, tiled. Rows, sections and tiles are made in Go.
using Gtk 4.0;

ApplicationWindow term {
  default-width: 1280;
  default-height: 800;

  // The sheets (actions, agents, keys, renaming) over the whole window.
  Overlay sheets {
    Box {
      // Column 1: the workspaces.
      Box workspaces_col {
        styles ["index", "term-col1"]
        orientation: vertical;
        hexpand: false;
        width-request: 232;

        // Finding a workspace, a new one and the menu, as tall as column 2's
        // head.
        Box {
          styles ["term-col-head", "term-find-row"]
          spacing: 6;

          SearchEntry find {
            styles ["index-search", "term-find-entry"]
            hexpand: true;
            placeholder-text: _("Find a workspace or agent");
          }

          Button new_workspace {
            styles ["plain", "term-head-button"]
            icon-name: "list-add-symbolic";
            valign: center;
          }

          Button menu {
            styles ["plain", "term-head-button"]
            icon-name: "open-menu-symbolic";
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          ListBox workspaces {
            selection-mode: single;
          }
        }

        // The agents that need you and those idle, as Warcraft's idle
        // worker: a click (or Ctrl+`) goes to the next one.
        Button finder {
          styles ["plain", "term-finder"]
          visible: false;
          halign: start;

          Box {
            spacing: 10;

            Box finder_waiting {
              spacing: 6;

              Box {
                styles ["mark", "s-warn"]
                valign: center;
              }

              Label finder_waiting_count {}
            }

            Box finder_idle {
              spacing: 6;

              Box {
                styles ["mark"]
                valign: center;
              }

              Label finder_idle_count {}
            }
          }
        }
      }

      // Column 2: the shown workspace's sessions, each a section of its
      // panes.
      Box sessions_col {
        styles ["index", "term-col2"]
        orientation: vertical;
        hexpand: false;
        width-request: 312;

        Box {
          styles ["term-col-head"]
          spacing: 8;

          Label sessions_title {
            styles ["term-col-title"]
            hexpand: true;
            xalign: 0;
            ellipsize: end;
            max-width-chars: 1;
          }

          Button new_session {
            styles ["plain", "term-head-button"]
            icon-name: "list-add-symbolic";
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box sessions {
            styles ["term-sessions"]
            orientation: vertical;
          }
        }
      }

      // Column 3: the shown session's panes, tiled, and nothing else.
      Overlay stage {
        hexpand: true;
        vexpand: true;

        Box tiles {
          styles ["term-tiles"]
          hexpand: true;
          vexpand: true;
        }
      }
    }
  }
}
