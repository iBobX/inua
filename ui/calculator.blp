// Calculator: the expression and its result, then the keys. The
// scientific keys sit to the left and show when Scientific is on. Every
// key carries its input in `name` ("k:7", "k:sin(", "op:=").
using Gtk 4.0;

ApplicationWindow calculator {
  default-width: 340;
  default-height: 520;

  Box {
    styles ["calc"]
    orientation: vertical;

    Box {
      styles ["calc-modes"]
      spacing: 6;

      ToggleButton sci {
        styles ["calc-toggle"]
        label: "Scientific";
      }

      ToggleButton deg {
        styles ["calc-toggle"]
        label: "Deg";
        active: true;
        tooltip-text: "Trigonometry in degrees (off: radians)";
      }

      Box {
        hexpand: true;
      }
    }

    Box {
      styles ["calc-display"]
      orientation: vertical;
      vexpand: true;
      valign: end;

      Label expression {
        styles ["calc-expr"]
        xalign: 1;
        ellipsize: start;
      }

      Label result {
        styles ["calc-result"]
        xalign: 1;
        ellipsize: start;
        label: "0";
      }
    }

    Box {
      styles ["calc-keys"]
      spacing: 8;
      homogeneous: false;

      Grid scikeys {
        visible: false;
        row-spacing: 8;
        column-spacing: 8;
        row-homogeneous: true;
        column-homogeneous: true;
      }

      Grid keys {
        hexpand: true;
        row-spacing: 8;
        column-spacing: 8;
        row-homogeneous: true;
        column-homogeneous: true;
      }
    }
  }
}
