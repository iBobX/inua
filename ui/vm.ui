                        <property name="wrap-mode">2</property>
                        <property name="selectable">true</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">resources</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">1</property>
                    <child>
                      <object class="GtkLabel">
                        <style>
                          <class name="sub"/>
                        </style>
                        <property name="label" translatable="yes">What it gets from this computer. Memory and CPU cores can change later.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="margin-bottom">8</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <style>
                          <class name="rows"/>
                        </style>
                        <property name="orientation">1</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="row"/>
                            </style>
                            <property name="spacing">16</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <property name="hexpand">true</property>
                                <property name="valign">3</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="label"/>
                                    </style>
                                    <property name="label" translatable="yes">Memory (GiB)</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="vm_new_memory_sub">
                                    <style>
                                      <class name="sub"/>
                                    </style>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="vm_new_memory">
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">2</property>
                                    <property name="upper">256</property>
                                    <property name="step-increment">1</property>
                                    <property name="page-increment">4</property>
                                    <property name="value">8</property>
                                  </object>
                                </property>
                                <property name="numeric">true</property>
                                <property name="width-chars">4</property>
                                <property name="valign">3</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="row"/>
                            </style>
                            <property name="spacing">16</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <property name="hexpand">true</property>
                                <property name="valign">3</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="label"/>
                                    </style>
                                    <property name="label" translatable="yes">CPU cores</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="vm_new_cpus_sub">
                                    <style>
                                      <class name="sub"/>
                                    </style>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="vm_new_cpus">
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">1</property>
                                    <property name="upper">256</property>
                                    <property name="step-increment">1</property>
                                    <property name="page-increment">2</property>
                                    <property name="value">4</property>
                                  </object>
                                </property>
                                <property name="numeric">true</property>
                                <property name="width-chars">4</property>
                                <property name="valign">3</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="row"/>
                            </style>
                            <property name="spacing">16</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <property name="hexpand">true</property>
                                <property name="valign">3</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="label"/>
                                    </style>
                                    <property name="label" translatable="yes">Disk size (GiB)</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="vm_new_disk_sub">
                                    <style>
                                      <class name="sub"/>
                                    </style>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="vm_new_disk">
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">8</property>
                                    <property name="upper">2048</property>
                                    <property name="step-increment">8</property>
                                    <property name="page-increment">64</property>
                                    <property name="value">64</property>
                                  </object>
                                </property>
                                <property name="numeric">true</property>
                                <property name="width-chars">4</property>
                                <property name="valign">3</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="margin-top">8</property>
            <child>
              <object class="GtkLabel" id="vm_create_note">
                <style>
                  <class name="sub"/>
                </style>
                <property name="label" translatable="yes">Writes the machine's definition. Nothing is installed or started yet.</property>
                <property name="hexpand">true</property>
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
                <property name="visible" bind-source="vm_create_note" bind-property="visible" bind-flags="sync-create|invert-boolean"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="vm_new_cancel">
                <style>
                  <class name="outlined"/>
                </style>
                <property name="name">new_cancel</property>
                <property name="label" translatable="yes">Cancel</property>
                <property name="valign">3</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="vm_new_back">
                <style>
                  <class name="outlined"/>
                </style>
                <property name="name">new_back</property>
                <property name="label" translatable="yes">Back</property>
                <property name="valign">3</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="vm_new_next">
                <style>
                  <class name="suggested-action"/>
                </style>
                <property name="name">new_next</property>
                <property name="label" translatable="yes">Next</property>
                <property name="valign">3</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="vm_create">
                <style>
                  <class name="suggested-action"/>
                </style>
                <property name="name">create_machine</property>
                <property name="label" translatable="yes">Create</property>
                <property name="valign">3</property>
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>