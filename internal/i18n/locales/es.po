#: internal/remoteui/window.go:798
msgid "Paired, but not saved, so not kept after this window: %v"
msgstr "Emparejado, pero no guardado: no se conservará al cerrar esta ventana: %v"

#: internal/remoteui/window.go:802
msgid "The PIN typed there was not this one. Pair again."
msgstr "El PIN que se escribió allí no era este. Vuelve a emparejar."

#: internal/remoteui/window.go:804
msgid "%s took the PIN, then refused this computer: it had this computer paired already, perhaps under another name, and refuses a computer paired twice. If it shares with inua, it has removed the old pairing: pair again. Otherwise unpair this computer there first."
msgstr "%s aceptó el PIN y luego rechazó este equipo: ya lo tenía emparejado, quizá con otro nombre, y rechaza un equipo emparejado dos veces. Si comparte con inua, ya ha quitado el emparejamiento anterior: vuelve a emparejar. Si no, desempareja este equipo allí primero."

#: internal/remoteui/window.go:807
msgid "Pairing failed: %v"
msgstr "El emparejamiento falló: %v"

#: internal/remoteui/window.go:822
msgid "Its session did not end: %v"
msgstr "Su sesión no terminó: %v"

#: internal/remoteui/window.go:835
msgid "Not forgotten: the list of machines was not saved: %v"
msgstr "No se olvidó: la lista de máquinas no se guardó: %v"

