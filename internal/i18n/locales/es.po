msgstr "Añadida, pero no guardada: no se conservará al cerrar esta ventana: %v"

#: internal/remoteui/window.go:941
msgid "This computer cannot decode it: choose another."
msgstr "Este ordenador no puede decodificarlo: elige otro."

#: internal/remoteui/window.go:943
msgid "Decoded by the processor here: slower than the graphics card."
msgstr "Aquí lo decodifica el procesador: más lento que la tarjeta gráfica."

