#: internal/remoteui/window.go:496
msgid "Lets your other devices see and control this desktop, with Moonlight or Remote Desktop."
msgstr "Permite que tus otros dispositivos vean y controlen este escritorio, con Moonlight o Escritorio remoto."

#: internal/remoteui/window.go:507
msgid "Sharing needs Sunshine, which is not installed."
msgstr "Compartir necesita Sunshine, que no está instalado."

#: internal/remoteui/window.go:508
msgid "Install the package for your system from github.com/LizardByte/Sunshine/releases (Ubuntu: sudo apt install ./sunshine_…_amd64.deb)."
msgstr "Instala el paquete para tu sistema desde github.com/LizardByte/Sunshine/releases (Ubuntu: sudo apt install ./sunshine_…_amd64.deb)."

#: internal/remoteui/window.go:510
msgid "The other device's keyboard and mouse cannot reach this desktop: /dev/uinput is not yours."
msgstr "El teclado y el ratón del otro dispositivo no pueden llegar a este escritorio: /dev/uinput no es tuyo."

#: internal/remoteui/window.go:513
msgid "Sharing needs a graphical session to show."
msgstr "Compartir necesita una sesión gráfica que mostrar."

#: internal/remoteui/window.go:538
msgid "A device"
msgstr "Un dispositivo"

#: internal/remoteui/window.go:542
msgid "at %s: type the PIN it shows"
msgstr "en %s: escribe el PIN que muestra"

#: internal/remoteui/window.go:569
msgid "No device is paired yet."
msgstr "Aún no hay ningún dispositivo emparejado."

#: internal/remoteui/window.go:574
msgid "The paired devices show while sharing is on."
msgstr "Los dispositivos emparejados se muestran mientras se comparte."

#: internal/remoteui/window.go:589
msgid "Paired twice, so it cannot connect: unpair each, then pair it again."
msgstr "Emparejado dos veces, así que no puede conectarse: desemparéjalo en cada caso y vuelve a emparejarlo."

#: internal/remoteui/window.go:619
msgid "A PIN is four digits."
msgstr "Un PIN tiene cuatro dígitos."

#: internal/remoteui/window.go:631
msgid "That is not the PIN %s shows."
msgstr "Ese no es el PIN que muestra %s."

#: internal/remoteui/window.go:633
msgid "%s was paired here before, as %s, and a device paired twice is refused. Its old pairing is removed: pair again from %s."
msgstr "%s ya estaba emparejado aquí, como %s, y se rechaza un dispositivo emparejado dos veces. Se ha quitado el emparejamiento anterior: vuelve a emparejar desde %s."

#: internal/remoteui/window.go:636
msgid "%s was not paired: %v"
msgstr "%s no se emparejó: %v"

#: internal/remoteui/window.go:657
msgid "%s was not unpaired: %v"
msgstr "%s no se desemparejó: %v"

#: internal/remoteui/window.go:721
msgid "Asking…"
msgstr "Preguntando…"

#: internal/remoteui/window.go:724
msgid "Connected: its desktop is in a window of its own."
msgstr "Conectada: su escritorio está en una ventana propia."

#: internal/remoteui/window.go:727
msgid "It does not answer: it is off, or not sharing its desktop."
msgstr "No responde: está apagada o no comparte su escritorio."

#: internal/remoteui/window.go:729
msgid "It shares with Nvidia's GameStream, which Remote Desktop does not speak."
msgstr "Comparte con GameStream de Nvidia, que Escritorio remoto no habla."

#: internal/remoteui/window.go:731
msgid "It has forgotten this computer: pair again."
msgstr "Ha olvidado este ordenador: vuelve a emparejar."

#: internal/remoteui/window.go:733
msgid "Not paired: pair once, with a PIN typed on it."
msgstr "Sin emparejar: empareja una vez, con un PIN que se escribe en ella."

#: internal/remoteui/window.go:735
msgid "Paired. Its desktop is being streamed; connecting joins in."
msgstr "Emparejada. Su escritorio se está transmitiendo; conectar se une a ello."

#: internal/remoteui/window.go:737
msgid "Paired, and ready."
msgstr "Emparejada y lista."

#: internal/remoteui/window.go:775
msgid "On %s, open Remote Desktop → Sharing (or Sunshine's PIN page) and type:"
